<dialog class="lightbox" data-lightbox aria-label="Image viewer">
  <div class="frame" data-frame>
    <img alt="" />
  </div>
  <div class="bar">
    <button type="button" class="nav" data-prev aria-label="Previous image"
      >←</button
    >
    <p class="mono" data-count aria-live="polite"></p>
    <button type="button" class="nav" data-next aria-label="Next image"
      >→</button
    >
    <button type="button" class="close mono" data-close>Close</button>
  </div>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(228 228 224 / 0.94);
    color: var(--ink);
    display: none;
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .lightbox[open] {
    display: grid;
    animation: lb-in 0.35s var(--ease-out);
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .frame {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: var(--gutter) var(--gutter) 0;
  }

  .frame img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 30px 80px -30px rgb(23 23 22 / 0.45);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 18px var(--gutter) 22px;
    position: relative;
  }

  .nav {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition:
      background 0.2s,
      color 0.2s;
  }

  .nav:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .close {
    position: absolute;
    right: var(--gutter);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 8px 0;
  }

  .close:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .single .nav,
  .single [data-count] {
    display: none;
  }

  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox[open] {
      animation: none;
    }
  }
</style>
