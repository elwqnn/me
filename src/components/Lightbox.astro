---
interface Props {
  images: string[]
  title: string
}

const { images, title } = Astro.props
const many = images.length > 1
---

<dialog
  class="lb"
  aria-label={`${title} images`}
  data-images={JSON.stringify(images)}
  data-title={title}
>
  <img class="lb-img" src={images[0]} alt="" />
  <div class="lb-bar glass">
    {
      many && (
        <button class="lb-btn" data-step="-1" aria-label="Previous image">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M10 3.5 5.5 8l4.5 4.5" />
          </svg>
        </button>
      )
    }
    <span class="lb-count" aria-live="polite"></span>
    {
      many && (
        <button class="lb-btn" data-step="1" aria-label="Next image">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M6 3.5 10.5 8 6 12.5" />
          </svg>
        </button>
      )
    }
    <button class="lb-btn" data-close aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8"></path>
      </svg>
    </button>
  </div>
</dialog>

<style>
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem) clamp(1rem, 4vw, 3rem) 6rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    opacity: 0;
    transition:
      opacity 0.45s var(--ease-out),
      overlay 0.45s allow-discrete,
      display 0.45s allow-discrete;
  }

  .lb[open] {
    display: grid;
    place-items: center;
    opacity: 1;
  }

  .lb::backdrop {
    background: rgb(36 28 64 / 0.42);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    backdrop-filter: blur(18px) saturate(1.3);
    opacity: 0;
    transition:
      opacity 0.45s var(--ease-out),
      overlay 0.45s allow-discrete,
      display 0.45s allow-discrete;
  }

  .lb[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .lb[open],
    .lb[open]::backdrop {
      opacity: 0;
    }
  }

  .lb-img {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    width: auto;
    height: auto;
    border-radius: 18px;
    box-shadow: 0 40px 120px -40px rgb(20 12 50 / 0.6);
    transition: scale 0.6s var(--ease-out);
  }

  .lb[open] .lb-img {
    scale: 1;
  }

  @starting-style {
    .lb[open] .lb-img {
      scale: 0.96;
    }
  }

  .lb-bar {
    position: fixed;
    left: 50%;
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: 999px;
  }

  .lb-btn {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    transition: background-color 0.4s var(--ease-out);
  }

  .lb-btn:hover {
    background: rgb(255 255 255 / 0.7);
  }

  .lb-btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lb-count {
    min-width: 4.5rem;
    text-align: center;
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>("dialog.lb")
  if (dlg) {
    const images: string[] = JSON.parse(dlg.dataset.images ?? "[]")
    const title = dlg.dataset.title ?? ""
    const img = dlg.querySelector<HTMLImageElement>(".lb-img")!
    const count = dlg.querySelector<HTMLElement>(".lb-count")!
    let current = 0

    const show = (n: number) => {
      current = (n + images.length) % images.length
      img.src = images[current]
      img.alt = `${title}, image ${current + 1} of ${images.length}`
      count.textContent = `${current + 1} / ${images.length}`
    }

    document.querySelectorAll<HTMLElement>("[data-open]").forEach((el) =>
      el.addEventListener("click", () => {
        show(Number(el.dataset.open))
        dlg.showModal()
      })
    )

    dlg
      .querySelectorAll<HTMLElement>("[data-step]")
      .forEach((el) =>
        el.addEventListener("click", () =>
          show(current + Number(el.dataset.step))
        )
      )
    dlg
      .querySelector("[data-close]")
      ?.addEventListener("click", () => dlg.close())

    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close()
    })
    dlg.addEventListener("keydown", (e) => {
      if (images.length < 2) return
      if (e.key === "ArrowRight") show(current + 1)
      if (e.key === "ArrowLeft") show(current - 1)
    })
  }
</script>
