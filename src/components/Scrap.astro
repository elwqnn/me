---
import { clean, rng, size, tornClips } from "./paper"

interface Props {
  seed: string
  width: string
  src?: string
  alt?: string
  href?: string
  index?: number
  rotate?: number
  speed?: number
  look?: "print" | "rip"
  tape?: boolean
  isNew?: boolean
  eager?: boolean
  class?: string
  style?: string
  [key: string]: unknown
}

const {
  seed,
  width,
  src,
  alt = "",
  href,
  index,
  rotate,
  speed = 0,
  look,
  tape,
  isNew,
  eager,
  class: className,
  style = "",
  ...rest
} = Astro.props

const rand = rng(seed)
const r = rotate ?? (rand() - 0.5) * 9
const kind = look ?? (rand() < 0.5 ? "print" : "rip")
const clip = tornClips(rand, kind === "rip" ? 7 : 5)
const dims = src ? size(src) : undefined
const tapeStyle = `--tx:${Math.round(30 + rand() * 40)}%;--tr:${((rand() - 0.5) * 16).toFixed(1)}deg;--tw:${Math.round(68 + rand() * 30)}px`
const Tag = href ? "a" : index !== undefined ? "button" : "div"
---

<Tag
  class:list={["scrap", className]}
  href={href}
  type={Tag === "button" ? "button" : undefined}
  tabindex={href ? -1 : undefined}
  aria-hidden={href ? "true" : undefined}
  draggable="false"
  data-scrap
  data-speed={speed}
  data-lightbox={index}
  style={`--w:${width};--r:${r.toFixed(2)}deg;${style}`}
  {...rest}
>
  <span class="scrap-body">
    {
      src ? (
        <span class={`scrap-paper ${kind}`} style={`clip-path:${clip.outer}`}>
          <img
            src={clean(src)}
            alt={alt}
            width={dims?.width}
            height={dims?.height}
            loading={eager ? "eager" : "lazy"}
            decoding="async"
            draggable="false"
            style={kind === "rip" ? `clip-path:${clip.inner}` : undefined}
          />
        </span>
      ) : (
        <slot />
      )
    }
    {tape && <span class="tape" style={tapeStyle} aria-hidden="true" />}
    {
      isNew && (
        <span class="sticker" aria-hidden="true">
          New
        </span>
      )
    }
  </span>
</Tag>

<style>
  .scrap {
    position: relative;
    display: block;
    width: var(--w);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: inherit;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    filter: drop-shadow(0 1px 1px rgb(58 40 15 / 0.2))
      drop-shadow(0 8px 12px rgb(58 40 15 / 0.14));
    transition: filter 0.45s var(--ease-out);
    will-change: translate;
  }

  .scrap-body {
    position: relative;
    display: block;
    rotate: calc(var(--r) + var(--tilt, 0deg));
    transition:
      rotate 0.6s var(--ease-out),
      scale 0.6s var(--ease-out);
  }

  .scrap-paper {
    display: block;
    background: var(--sheet);
  }

  .scrap-paper.print {
    padding: clamp(5px, 3.2%, 10px);
  }

  .scrap-paper img {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  .tape {
    position: absolute;
    top: -13px;
    left: var(--tx);
    width: var(--tw);
    height: 26px;
    translate: -50% 0;
    rotate: var(--tr);
    background:
      linear-gradient(
        100deg,
        rgb(255 255 255 / 0.05),
        rgb(255 255 255 / 0.28) 40%,
        rgb(255 255 255 / 0.04)
      ),
      rgb(229 218 190 / 0.74);
    clip-path: polygon(
      2% 0,
      98% 0,
      100% 16%,
      97% 33%,
      100% 51%,
      97% 70%,
      100% 88%,
      98% 100%,
      2% 100%,
      0 84%,
      3% 66%,
      0 47%,
      3% 29%,
      0 11%
    );
  }

  .sticker {
    position: absolute;
    top: -16px;
    right: -14px;
    display: grid;
    place-items: center;
    width: 54px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--orange);
    box-shadow:
      inset 0 0 0 3px rgb(255 255 255 / 0.22),
      0 2px 3px rgb(58 40 15 / 0.2);
    color: var(--ink);
    font: 600 11px/1 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    rotate: 14deg;
  }

  .scrap:hover,
  :global(.lift:hover) .scrap,
  :global(.lift:focus-within) .scrap,
  .scrap.is-dragging {
    filter: drop-shadow(0 2px 2px rgb(58 40 15 / 0.18))
      drop-shadow(0 22px 26px rgb(58 40 15 / 0.2));
  }

  .scrap:hover .scrap-body,
  :global(.lift:hover) .scrap-body,
  :global(.lift:focus-within) .scrap-body {
    rotate: calc(var(--r) * 0.45 + var(--tilt, 0deg));
    scale: 1.03;
  }

  .scrap.is-dragging .scrap-body {
    scale: 1.06;
    transition-duration: 0.25s;
  }

  .scrap:focus-visible {
    outline-offset: 8px;
  }

  @media (hover: hover) and (pointer: fine) {
    .scrap {
      cursor: grab;
    }
    .scrap.is-dragging {
      cursor: grabbing;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .scrap:not(.is-in) .scrap-body {
      opacity: 0;
      scale: 1.14;
      translate: 0 -18px;
      rotate: calc(var(--r) + 9deg);
    }
    .scrap-body {
      transition:
        rotate 0.7s var(--spring),
        scale 0.7s var(--spring),
        translate 0.8s var(--spring),
        opacity 0.3s ease;
      transition-delay: var(--delay, 0s);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scrap,
    .scrap-body {
      transition: none;
    }
  }
</style>

<script>
  type Item = {
    el: HTMLElement
    dx: number
    dy: number
    py: number
    base: number
    speed: number
  }

  const motion = matchMedia(
    "(prefers-reduced-motion: no-preference) and (min-width: 1100px)"
  )
  const fine = matchMedia("(hover: hover) and (pointer: fine)")
  const items: Item[] = [
    ...document.querySelectorAll<HTMLElement>("[data-scrap]"),
  ].map((el) => ({
    el,
    dx: 0,
    dy: 0,
    py: 0,
    base: 0,
    speed: Number(el.dataset.speed) || 0,
  }))

  const paint = (s: Item) => {
    s.el.style.translate = `${s.dx}px ${s.dy + s.py}px`
  }

  let queued = false
  function update() {
    queued = false
    const vh = innerHeight
    const mid = scrollY + vh / 2
    for (const s of items) {
      if (!s.speed) continue
      const near = Math.abs(s.base - mid) < vh * 1.4
      const py = !motion.matches
        ? 0
        : near
          ? (Math.max(s.base, vh / 2) - mid) * s.speed
          : s.py
      if (py !== s.py) {
        s.py = py
        paint(s)
      }
    }
  }

  function measure() {
    for (const s of items) {
      const r = s.el.getBoundingClientRect()
      s.base = r.top + scrollY + r.height / 2 - s.dy - s.py
    }
    update()
  }

  addEventListener(
    "scroll",
    () => {
      if (queued) return
      queued = true
      requestAnimationFrame(update)
    },
    { passive: true }
  )
  motion.addEventListener("change", measure)
  new ResizeObserver(measure).observe(document.documentElement)

  let z = 50
  for (const s of items) {
    const el = s.el
    el.addEventListener("pointerdown", (e) => {
      if (!fine.matches || e.button !== 0) return
      e.preventDefault()
      el.setPointerCapture(e.pointerId)
      const ox = e.clientX - s.dx
      const oy = e.clientY - s.dy
      let last = e.clientX
      let moved = false
      el.style.zIndex = String(++z)

      const move = (e: PointerEvent) => {
        const dx = e.clientX - ox
        const dy = e.clientY - oy
        if (!moved) {
          if (Math.hypot(dx - s.dx, dy - s.dy) < 5) return
          moved = true
          el.classList.add("is-dragging")
        }
        const tilt = Math.max(-9, Math.min(9, (e.clientX - last) * 0.7))
        el.style.setProperty("--tilt", `${tilt.toFixed(1)}deg`)
        last = e.clientX
        s.dx = dx
        s.dy = dy
        paint(s)
      }

      const block = (e: Event) => {
        e.preventDefault()
        e.stopImmediatePropagation()
      }

      const up = () => {
        el.removeEventListener("pointermove", move)
        el.removeEventListener("pointerup", up)
        el.removeEventListener("pointercancel", up)
        el.removeEventListener("lostpointercapture", up)
        el.classList.remove("is-dragging")
        el.style.removeProperty("--tilt")
        if (!moved) return
        el.addEventListener("click", block, { capture: true, once: true })
        setTimeout(() => el.removeEventListener("click", block, true))
      }

      el.addEventListener("pointermove", move)
      el.addEventListener("pointerup", up)
      el.addEventListener("pointercancel", up)
      el.addEventListener("lostpointercapture", up)
    })
  }

  const io = new IntersectionObserver(
    (entries) => {
      let k = 0
      for (const e of entries) {
        if (!e.isIntersecting) continue
        const el = e.target as HTMLElement
        el.style.setProperty("--delay", `${k++ * 90}ms`)
        el.classList.add("is-in")
        io.unobserve(el)
        setTimeout(() => el.style.removeProperty("--delay"), 1500)
      }
    },
    { rootMargin: "0px 0px -6% 0px" }
  )
  for (const s of items) io.observe(s.el)
</script>
