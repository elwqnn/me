---
import Arrow from "./Arrow.astro"

interface Props {
  images: {
    src: string
    alt: string
    wide: boolean
    width?: number
    height?: number
  }[]
}

const { images } = Astro.props
const pad = (n: number) => String(n).padStart(2, "0")
---

<section class="gallery" aria-labelledby="gallery-title" data-gallery>
  <div class="head">
    <h2 id="gallery-title" class="label">Images</h2>
    <span class="label">{pad(images.length)}</span>
  </div>

  <ul class="grid">
    {
      images.map((img, i) => (
        <li class:list={{ wide: img.wide || i === 0 }}>
          <button type="button" data-open={i}>
            <img
              src={img.src}
              alt={img.alt}
              width={img.width}
              height={img.height}
              loading={i < 2 ? "eager" : "lazy"}
              decoding="async"
              class:list={{ pixel: (img.width ?? 1000) <= 512 }}
            />
            <span class="sr-only">Open full size</span>
          </button>
          <span class="label n">{pad(i + 1)}</span>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label="Image viewer">
    <img alt="" data-view />
    <div class="bar">
      <span class="label" data-count></span>
      <span class="caption" data-caption></span>
      <div class="controls">
        {
          images.length > 1 && (
            <>
              <button type="button" data-step="-1" aria-label="Previous image">
                <Arrow turn={180} />
              </button>
              <button type="button" data-step="1" aria-label="Next image">
                <Arrow />
              </button>
            </>
          )
        }
        <button type="button" class="close label" data-close autofocus>
          Close
        </button>
      </div>
    </div>
  </dialog>
</section>

<style>
  .gallery {
    padding: 0 var(--gutter) clamp(72px, 12vh, 128px);
  }

  .head {
    display: flex;
    justify-content: space-between;
    padding-bottom: 12px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--rule);
  }

  .grid {
    columns: 2;
    column-gap: 20px;
  }

  li {
    position: relative;
    break-inside: avoid;
    margin-bottom: 20px;
  }

  li.wide {
    column-span: all;
  }

  li button {
    display: block;
    width: 100%;
    overflow: hidden;
    cursor: zoom-in;
    background: color-mix(in oklab, var(--accent) 6%, var(--bg));
  }

  li img {
    width: 100%;
    height: auto;
    transition:
      transform 1.1s var(--ease-out),
      filter 0.6s var(--ease-out);
  }

  li button:hover img {
    transform: scale(1.018);
  }

  .pixel {
    image-rendering: pixelated;
  }

  .n {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 3px 6px;
    color: var(--fg);
    background: rgb(11 12 10 / 0.72);
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
    pointer-events: none;
  }

  li:hover .n,
  li:focus-within .n {
    opacity: 1;
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(16px, 4vw, 48px) clamp(16px, 4vw, 48px) 0;
    border: 0;
    color: var(--fg);
    background: rgb(11 12 10 / 0.94);
    display: none;
    grid-template-rows: minmax(0, 1fr) auto;
    place-items: center;
    opacity: 0;
    transition:
      opacity 0.35s var(--ease-out),
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
  }

  .lightbox[open] {
    display: grid;
    opacity: 1;
  }

  @starting-style {
    .lightbox[open] {
      opacity: 0;
    }
  }

  .lightbox::backdrop {
    background: transparent;
  }

  [data-view] {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .bar {
    width: 100%;
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
  }

  .caption {
    color: var(--fg-2);
    font-size: 0.9375rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .controls button {
    display: grid;
    place-items: center;
    min-width: 44px;
    height: 44px;
    padding: 0 12px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    transition:
      border-color 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }

  .controls button:hover {
    border-color: var(--fg-3);
    background: rgb(236 232 220 / 0.06);
  }

  .close {
    color: var(--fg);
  }

  @media (max-width: 719px) {
    .grid {
      columns: 1;
    }

    .bar {
      grid-template-columns: auto 1fr;
    }

    .caption {
      display: none;
    }

    .controls {
      justify-content: flex-end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    li img,
    .lightbox {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
    const dialog = root.querySelector("dialog")
    const view = root.querySelector<HTMLImageElement>("[data-view]")
    const count = root.querySelector("[data-count]")
    const caption = root.querySelector("[data-caption]")
    const items = [...root.querySelectorAll<HTMLImageElement>(".grid img")]
    if (!dialog || !view || !count || !caption) return
    let index = 0

    const show = (i: number) => {
      index = (i + items.length) % items.length
      const item = items[index]
      view.src = item.src
      view.alt = item.alt
      view.classList.toggle("pixel", item.classList.contains("pixel"))
      count.textContent = `${index + 1} / ${items.length}`
      caption.textContent = item.alt
    }

    root.querySelectorAll<HTMLElement>("[data-open]").forEach((button) => {
      button.addEventListener("click", () => {
        show(Number(button.dataset.open))
        dialog.showModal()
      })
    })

    root.querySelectorAll<HTMLElement>("[data-step]").forEach((button) => {
      button.addEventListener("click", () =>
        show(index + Number(button.dataset.step))
      )
    })

    root
      .querySelector("[data-close]")
      ?.addEventListener("click", () => dialog.close())

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close()
    })

    dialog.addEventListener("keydown", (e) => {
      if (items.length < 2) return
      if (e.key === "ArrowLeft") show(index - 1)
      if (e.key === "ArrowRight") show(index + 1)
    })
  })
</script>
