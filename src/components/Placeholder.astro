---
import { tint } from "./aura"

interface Props {
  title: string
  accent?: string
  class?: string
}

const { title, accent, class: className } = Astro.props
const [a0, a1, a2, a3] = tint(accent)
const nodes = [
  [168, 70],
  [250, 96],
  [282, 168],
  [236, 246],
  [128, 262],
  [70, 196],
  [92, 104],
]
---

<div
  class:list={["ph", className]}
  style={`--p0:${a0};--p1:${a1};--p2:${a2};--p3:${a3}`}
  role="img"
  aria-label={`${title}: generated diagram of one publisher sending to many subscribers`}
>
  <svg viewBox="0 0 340 340" preserveAspectRatio="xMidYMid slice">
    <g class="lines">
      {nodes.map(([x, y]) => <line x1="170" y1="170" x2={x} y2={y} />)}
    </g>
    <g class="rings">
      <circle cx="170" cy="170" r="44"></circle>
      <circle cx="170" cy="170" r="84"></circle>
      <circle cx="170" cy="170" r="124"></circle>
    </g>
    <g class="nodes">
      {
        nodes.map(([x, y], i) => (
          <circle cx={x} cy={y} r="4.5" style={`--i:${i}`} />
        ))
      }
    </g>
    <circle class="core" cx="170" cy="170" r="9"></circle>
  </svg>
  <span class="word">{title}</span>
</div>

<style>
  .ph {
    position: relative;
    display: grid;
    overflow: hidden;
    background:
      radial-gradient(60% 70% at 24% 26%, var(--p2), transparent 70%),
      radial-gradient(55% 60% at 82% 78%, var(--p1), transparent 72%),
      radial-gradient(50% 55% at 78% 18%, var(--p3), transparent 70%), var(--p0);
    color: var(--ink);
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: rgb(255 255 255 / 0.85);
  }

  .lines line {
    stroke: currentColor;
    stroke-width: 0.8;
    stroke-dasharray: 2 4;
    opacity: 0.7;
  }

  .rings circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.8;
    opacity: 0.55;
  }

  .rings {
    transform-origin: 170px 170px;
    animation: breathe 7s var(--ease-soft) infinite alternate;
  }

  .nodes circle {
    fill: currentColor;
    animation: blink 3.6s var(--ease-soft) infinite;
    animation-delay: calc(var(--i) * 0.42s);
  }

  .core {
    fill: var(--ink);
  }

  .word {
    position: relative;
    align-self: end;
    justify-self: start;
    padding: clamp(1rem, 2.4vw, 1.75rem);
    font-size: clamp(3rem, 1.6rem + 4.4vw, 6rem);
    font-weight: 200;
    letter-spacing: -0.06em;
    line-height: 0.8;
  }

  @keyframes breathe {
    to {
      transform: scale(1.06);
    }
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 0.45;
    }
    40% {
      opacity: 1;
    }
  }
</style>
