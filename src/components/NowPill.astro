---
import Arrow from "./Arrow.astro"
---

<div class="now">
  <button
    class="pill-btn glass"
    popovertarget="reach"
    aria-label="Now: Aktislab, Lyon. Open contact links"
  >
    <span class="pulse" aria-hidden="true"></span>
    <span><span class="k">Now:</span> Aktislab, Lyon</span>
    <svg
      class="chev"
      width="12"
      height="12"
      viewBox="0 0 12 12"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M3 7.5 6 4.5l3 3"></path>
    </svg>
  </button>

  <div id="reach" popover class="sheet glass">
    <p class="label">Say hello</p>
    <ul role="list">
      <li>
        <a href="mailto:elwann.guillemot@epitech.eu">
          <span class="t">Email</span>
          <span class="v">elwann.guillemot@epitech.eu</span>
          <Arrow />
        </a>
      </li>
      <li>
        <a
          href="https://github.com/elwqnn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="t">GitHub</span>
          <span class="v">@elwqnn</span>
          <Arrow angle={-45} />
        </a>
      </li>
      <li>
        <a href="/documents/elwann_guillemot_resume.pdf">
          <span class="t">Resume</span>
          <span class="v">PDF</span>
          <Arrow angle={90} />
        </a>
      </li>
    </ul>
  </div>
</div>

<style>
  .now {
    position: fixed;
    left: 50%;
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 10;
    translate: -50% 0;
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    height: 3rem;
    padding: 0 1.1rem 0 1rem;
    border-radius: 999px;
    font-size: var(--fs-small);
    font-weight: 450;
    white-space: nowrap;
    transition:
      transform 0.6s var(--ease-out),
      box-shadow 0.6s var(--ease-out);
  }

  .pill-btn:hover {
    transform: translateY(-2px);
  }

  .k {
    color: var(--ink-3);
  }

  .pulse {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #3fa874;
  }

  .pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: ping 2.4s var(--ease-out) infinite;
  }

  .chev {
    color: var(--ink-3);
    transition: rotate 0.5s var(--ease-out);
  }

  .now:has(.sheet:popover-open) .chev {
    rotate: 180deg;
  }

  .sheet {
    position: fixed;
    inset: auto auto calc(max(1.25rem, env(safe-area-inset-bottom)) + 3.75rem)
      50%;
    width: min(22rem, calc(100vw - 2rem));
    margin: 0;
    padding: 1rem 0.5rem 0.5rem;
    border-radius: 24px;
    color: var(--ink);
    background:
      linear-gradient(165deg, rgb(255 255 255 / 0.78), rgb(255 255 255 / 0.5)),
      transparent;
    opacity: 0;
    transform: translate(-50%, 10px) scale(0.96);
    transform-origin: 50% 100%;
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.5s var(--ease-out),
      overlay 0.5s allow-discrete,
      display 0.5s allow-discrete;
  }

  .sheet:popover-open {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }

  @starting-style {
    .sheet:popover-open {
      opacity: 0;
      transform: translate(-50%, 10px) scale(0.96);
    }
  }

  .sheet .label {
    padding: 0 0.75rem 0.6rem;
  }

  .sheet a {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 0.75rem;
    border-radius: 16px;
    font-size: var(--fs-small);
    transition: background-color 0.4s var(--ease-out);
  }

  .sheet a:hover,
  .sheet a:focus-visible {
    background: rgb(255 255 255 / 0.75);
  }

  .t {
    color: var(--ink-3);
  }

  .v {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @keyframes ping {
    from {
      opacity: 0.6;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 3;
    }
  }
</style>
