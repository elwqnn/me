---
interface Props {
  class?: string
}

const { class: cls } = Astro.props
---

<div class:list={["field overflow-hidden", cls]} data-field>
  <canvas class="absolute top-0 left-0" aria-hidden="true"></canvas>
  <p
    class="hint label pointer-events-none absolute right-0 bottom-0 border-t border-l border-ink bg-paper px-3 py-2"
  >
    <span class="hidden [@media(hover:hover)]:inline">Move to light it</span>
    <span class="[@media(hover:hover)]:hidden">Tap to light it</span>
  </p>
</div>

<style>
  .field {
    background: radial-gradient(var(--ink) 1.2px, transparent 1.6px) 0 0 / 6px
      6px;
    touch-action: pan-y;
  }

  canvas {
    image-rendering: pixelated;
  }

  .hint {
    display: none;
  }

  [data-live] .hint {
    display: block;
  }
</style>

<script>
  import { reduced, rgb } from "./dither"

  const VERT = `#version 300 es
in vec2 p;
void main() { gl_Position = vec4(p, 0.0, 1.0); }`

  const FRAG = `#version 300 es
precision highp float;
uniform vec2 uRes;
uniform float uTime;
uniform vec3 uPointer;
uniform vec3 uInk;
uniform vec3 uPaper;
out vec4 color;

float hash(vec2 p) {
  p = fract(p * vec2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return fract(p.x * p.y);
}

float noise(vec2 p) {
  vec2 i = floor(p), f = fract(p);
  vec2 u = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash(i), hash(i + vec2(1, 0)), u.x),
             mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);
}

float fbm(vec2 p) {
  float v = 0.0, a = 0.5;
  for (int i = 0; i < 5; i++) {
    v += a * noise(p);
    p = mat2(1.6, 1.2, -1.2, 1.6) * p;
    a *= 0.5;
  }
  return v;
}

float bayer2(vec2 a) { a = floor(a); return fract(a.x / 2.0 + a.y * a.y * 0.75); }
float bayer4(vec2 a) { return bayer2(0.5 * a) * 0.25 + bayer2(a); }
float bayer8(vec2 a) { return bayer4(0.5 * a) * 0.25 + bayer2(a); }

void main() {
  vec2 p = gl_FragCoord.xy / uRes.y * 2.4;
  float t = uTime * 0.05;
  vec2 q = vec2(fbm(p + vec2(0.0, t)), fbm(p + vec2(5.2, 1.3) - t));
  vec2 r = vec2(fbm(p + 3.2 * q + vec2(1.7, 9.2) + 0.7 * t),
                fbm(p + 3.2 * q + vec2(8.3, 2.8) - 0.5 * t));
  float v = fbm(p + 2.6 * r);
  float d = distance(gl_FragCoord.xy, uPointer.xy) / uRes.y;
  v += uPointer.z * 0.7 * exp(-d * d * 14.0);
  v = smoothstep(0.32, 0.78, v);
  color = vec4(v > bayer8(gl_FragCoord.xy) ? uPaper : uInk, 1.0);
}`

  const PX = 4

  for (const el of document.querySelectorAll<HTMLElement>("[data-field]")) {
    const canvas = el.querySelector("canvas")!
    const gl = canvas.getContext("webgl2", { antialias: false, alpha: false })
    if (!gl) continue

    const program = gl.createProgram()!
    for (const [type, src] of [
      [gl.VERTEX_SHADER, VERT],
      [gl.FRAGMENT_SHADER, FRAG],
    ] as const) {
      const shader = gl.createShader(type)!
      gl.shaderSource(shader, src)
      gl.compileShader(shader)
      gl.attachShader(program, shader)
    }
    gl.linkProgram(program)
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) continue
    gl.useProgram(program)

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer())
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW
    )
    const loc = gl.getAttribLocation(program, "p")
    gl.enableVertexAttribArray(loc)
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0)

    const u = (name: string) => gl.getUniformLocation(program, name)
    const uRes = u("uRes")
    const uTime = u("uTime")
    const uPointer = u("uPointer")
    gl.uniform3fv(
      u("uInk"),
      rgb("--ink").map((c) => c / 255)
    )
    gl.uniform3fv(
      u("uPaper"),
      rgb("--paper").map((c) => c / 255)
    )

    let scale = 1
    const pointer = { x: 0, y: 0, z: 0, tx: 0, ty: 0, tz: 0 }
    const seed = Math.random() * 200

    const draw = (time: number) => {
      pointer.x += (pointer.tx - pointer.x) * 0.12
      pointer.y += (pointer.ty - pointer.y) * 0.12
      pointer.z += (pointer.tz - pointer.z) * 0.06
      gl.uniform1f(uTime, seed + time * 0.001)
      gl.uniform3f(uPointer, pointer.x, pointer.y, pointer.z)
      gl.drawArrays(gl.TRIANGLES, 0, 3)
    }

    const resize = () => {
      const dpr = window.devicePixelRatio || 1
      const dev = Math.max(1, Math.round(PX * dpr))
      scale = dpr / dev
      canvas.width = Math.ceil(el.clientWidth * scale)
      canvas.height = Math.ceil(el.clientHeight * scale)
      canvas.style.width = `${(canvas.width * dev) / dpr}px`
      canvas.style.height = `${(canvas.height * dev) / dpr}px`
      gl.viewport(0, 0, canvas.width, canvas.height)
      gl.uniform2f(uRes, canvas.width, canvas.height)
      if (reduced) draw(8000)
    }
    new ResizeObserver(resize).observe(el)
    resize()

    if (reduced) continue
    el.dataset.live = ""

    let fade = 0
    const light = (e: PointerEvent) => {
      const r = el.getBoundingClientRect()
      pointer.tx = (e.clientX - r.left) * scale
      pointer.ty = (r.bottom - e.clientY) * scale
      if (!pointer.tz) {
        pointer.x = pointer.tx
        pointer.y = pointer.ty
      }
      pointer.tz = 1
      clearTimeout(fade)
      if (e.pointerType === "touch")
        fade = window.setTimeout(() => (pointer.tz = 0), 1600)
    }
    el.addEventListener("pointerdown", light)
    el.addEventListener("pointermove", light)
    el.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "touch") pointer.tz = 0
    })

    let raf = 0
    const loop = (time: number) => {
      draw(time)
      raf = requestAnimationFrame(loop)
    }
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !raf) raf = requestAnimationFrame(loop)
      else if (!entry.isIntersecting && raf) {
        cancelAnimationFrame(raf)
        raf = 0
      }
    }).observe(el)
  }
</script>
