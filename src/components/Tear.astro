---
import { rng, tearPaths } from "./paper"

interface Props {
  seed: string
  edge?: "top" | "bottom"
}

const { seed, edge = "top" } = Astro.props
const { solid, fiber } = tearPaths(rng(seed))
---

<svg
  class:list={["tear", edge]}
  viewBox="0 0 1000 24"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path class="fiber" d={fiber}></path>
  <path d={solid}></path>
</svg>

<style>
  .tear {
    position: absolute;
    left: 0;
    width: 100%;
    height: 22px;
    fill: var(--sheet);
    pointer-events: none;
    filter: drop-shadow(0 -1px 1px rgb(58 40 15 / 0.12));
  }

  .top {
    bottom: calc(100% - 1px);
  }

  .bottom {
    top: calc(100% - 1px);
    scale: 1 -1;
  }

  .fiber {
    opacity: 0.6;
  }
</style>
