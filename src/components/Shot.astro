---
import { cleanSrc, imageSize, isWide } from "@/components/images"

interface Props {
  src: string
  alt: string
  index: number
  total: number
  hero?: boolean
}

const { src, alt, index, total, hero = false } = Astro.props
const url = cleanSrc(src)
const size = imageSize(src)
const pixel = size ? size.width <= 800 : false
const name = url
  .split("/")
  .pop()!
  .replace(/\.\w+$/, "")
  .replace(/[-_]+/g, " ")
const pad = (n: number) => String(n).padStart(2, "0")
---

<figure
  class:list={["shot", { hero, wide: isWide(src) }]}
  style={size ? `--ratio: ${size.width / size.height}` : undefined}
  data-reveal
>
  <a class="frame" href={url} data-shot aria-label={`${alt}, open full size`}>
    <img
      src={url}
      alt={alt}
      width={size?.width}
      height={size?.height}
      loading={hero ? "eager" : "lazy"}
      decoding="async"
      class:list={{ pixel }}
    />
  </a>
  <figcaption class="mono dim">
    <span>{pad(index + 1)}/{pad(total)}</span>
    <span>{name}</span>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>(".shot").forEach((shot) => {
    const img = shot.querySelector("img")
    const done = () => shot.classList.add("is-loaded")
    if (!img || img.complete) return done()
    img.addEventListener("load", done, { once: true })
    img.addEventListener("error", done, { once: true })
  })
</script>

<style>
  .shot {
    break-inside: avoid;
    margin-bottom: clamp(28px, 3vw, 44px);
  }

  .wide {
    column-span: all;
  }

  .frame {
    display: block;
    overflow: hidden;
    background: #141413;
    cursor: zoom-in;
  }

  .hero {
    width: min(100%, calc(88svh * var(--ratio, 1.78)));
    margin-inline: auto;
  }

  img {
    width: 100%;
    height: auto;
    transition: scale 0.9s var(--ease-out);
  }

  .pixel {
    image-rendering: pixelated;
  }

  .frame:hover img {
    scale: 1.025;
  }

  figcaption {
    display: flex;
    gap: 1.2em;
    margin-top: 12px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .shot .frame {
      clip-path: inset(100% 0 0 0);
      transition: clip-path 1.3s var(--ease-inout);
    }

    :global(html.js) .shot img {
      transform: scale(1.22) translateY(4%);
      transition:
        transform 1.8s var(--ease-out),
        scale 0.9s var(--ease-out);
    }

    :global(html.js) .shot figcaption {
      opacity: 0;
      transition: opacity 0.8s var(--ease-out) 0.6s;
    }

    :global(html.js) .shot.is-in.is-loaded .frame {
      clip-path: inset(0 0 0 0);
    }

    :global(html.js) .shot.is-in.is-loaded img {
      transform: none;
    }

    :global(html.js) .shot.is-in.is-loaded figcaption {
      opacity: 1;
    }
  }
</style>
