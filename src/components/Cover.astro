---
import { clean } from "./images"

interface Props {
  src?: string
  slug: string
  title: string
  accent: string
  eager?: boolean
}

const { src, slug, title, accent, eager = false } = Astro.props

let seed = [...slug].reduce(
  (h, c) => Math.imul(h ^ c.charCodeAt(0), 16777619),
  2166136261
)
const rand = () => {
  seed = (seed + 0x6d2b79f5) | 0
  let t = Math.imul(seed ^ (seed >>> 15), seed | 1)
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61)
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296
}

const cx = 200
const cy = 150
const tilt = 0.42
const radii = [34, 62, 94, 130, 170, 214]
const nodes = radii.flatMap((r, k) =>
  Array.from({ length: 1 + Math.floor(rand() * 3) }, () => {
    const a = rand() * Math.PI * 2
    return {
      x: cx + r * Math.cos(a),
      y: cy + r * tilt * Math.sin(a),
      size: 2 + rand() * 2.5,
      hollow: rand() > 0.6,
      linked: k > 0 && rand() > 0.35,
    }
  })
)
const f = (n: number) => n.toFixed(1)
---

{
  src ? (
    <img
      src={clean(src)}
      alt={`${title} cover`}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      draggable="false"
    />
  ) : (
    <span class="art" style={`--bg:${accent}`}>
      <svg
        viewBox="0 0 400 300"
        preserveAspectRatio="xMidYMid slice"
        role="img"
        aria-label={`${title}, generated cover`}
      >
        <g fill="none" stroke="currentColor" stroke-width="0.75">
          {radii.map((r) => (
            <ellipse cx={cx} cy={cy} rx={r} ry={f(r * tilt)} opacity="0.32" />
          ))}
          {nodes
            .filter((n) => n.linked)
            .map((n) => (
              <line
                x1={cx}
                y1={cy}
                x2={f(n.x)}
                y2={f(n.y)}
                opacity="0.55"
                stroke-dasharray="2 3"
              />
            ))}
        </g>
        {nodes.map((n) => (
          <circle
            cx={f(n.x)}
            cy={f(n.y)}
            r={f(n.size)}
            class:list={{ hollow: n.hollow }}
            fill="currentColor"
            stroke="currentColor"
            stroke-width="1"
          />
        ))}
        <circle cx={cx} cy={cy} r="13" fill="none" stroke="currentColor" />
        <circle cx={cx} cy={cy} r="6.5" fill="currentColor" />
      </svg>
      <span class="art-title">{title}</span>
    </span>
  )
}

<style>
  .art {
    position: absolute;
    inset: 0;
    display: block;
    background: var(--bg);
    color: #161612;
  }

  .art svg {
    width: 100%;
    height: 100%;
  }

  .hollow {
    fill: var(--bg);
  }

  .art-title {
    position: absolute;
    left: 5.5cqw;
    bottom: 4.5cqw;
    font-family: var(--mono);
    font-size: max(11px, 7cqw);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }
</style>
