---
interface Props {
  back?: boolean
}

const { back } = Astro.props
---

<header class="topbar mono">
  {
    back ? (
      <a href="/#work" class="home">
        <span aria-hidden="true">←</span> Index
      </a>
    ) : (
      <a href="/" class="home">
        Elwann Guillemot
      </a>
    )
  }
  {
    back ? (
      <a href="/" class="mid">
        Elwann Guillemot <span class="role">— Back-end Developer</span>
      </a>
    ) : (
      <nav class="mid" aria-label="Sections">
        <a href="#today">
          <span>01</span> Today
        </a>
        <a href="#work">
          <span>02</span> Work
        </a>
        <a href="#contact">
          <span>03</span> Contact
        </a>
      </nav>
    )
  }
  <p class="clock">Lyon, FR<span data-clock></span></p>
</header>

<style>
  .topbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 26px 32px 0;
    color: var(--ink-3);
    position: relative;
    z-index: 2;
  }

  a {
    text-decoration: none;
    color: var(--ink);
    transition: color 0.2s;
  }

  a:hover {
    color: var(--orange-ink);
  }

  .home {
    justify-self: start;
    font-weight: 600;
  }

  .mid {
    display: flex;
    gap: 22px;
  }

  .mid span {
    color: var(--orange-ink);
  }

  .mid .role {
    color: var(--ink-3);
  }

  .clock {
    justify-self: end;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 759px) {
    .topbar {
      grid-template-columns: 1fr auto;
      padding: 18px 18px 0;
    }
    .clock {
      display: none;
    }
    .mid {
      justify-self: end;
      gap: 14px;
    }
    .mid span,
    .mid .role {
      display: none;
    }
  }
</style>

<script>
  const out = document.querySelector<HTMLElement>("[data-clock]")
  const fmt = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Europe/Paris",
    hour: "2-digit",
    minute: "2-digit",
  })
  const tick = () => {
    if (out) out.textContent = ` · ${fmt.format(new Date())}`
  }
  tick()
  setInterval(tick, 15000)
</script>
