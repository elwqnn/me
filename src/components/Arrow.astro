---
interface Props {
  turn?: number
}

const { turn = 0 } = Astro.props
---

<svg
  class="arrow"
  viewBox="0 0 16 16"
  width="0.8em"
  height="0.8em"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  aria-hidden="true"
  style={turn ? `transform: rotate(${turn}deg)` : undefined}
>
  <path d="M2 8h11M8.5 3.5 13 8l-4.5 4.5"></path>
</svg>

<style>
  .arrow {
    display: inline-block;
    flex: none;
    vertical-align: -0.04em;
    transition: translate 0.4s var(--ease-out);
  }
</style>
