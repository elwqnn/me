---
interface Props {
  dir?: "right" | "left" | "up" | "down" | "out"
  size?: number
  class?: string
}

const { dir = "right", size = 14, class: cls } = Astro.props

const bitmap =
  dir === "out"
    ? [
        "...####",
        ".....##",
        "....#.#",
        "...#..#",
        "..#....",
        ".#.....",
        "#......",
      ]
    : [
        "...#...",
        "....#..",
        ".....#.",
        "#######",
        ".....#.",
        "....#..",
        "...#...",
      ]

const turn = { right: 0, down: 90, left: 180, up: 270, out: 0 }[dir]

const d = bitmap
  .flatMap((row, y) =>
    [...row].map((c, x) => (c === "#" ? `M${x} ${y}h1v1h-1z` : ""))
  )
  .join("")
---

<svg
  viewBox="0 0 7 7"
  width={size}
  height={size}
  fill="currentColor"
  shape-rendering="crispEdges"
  aria-hidden="true"
  class:list={["inline-block shrink-0", cls]}
  style={turn ? `transform:rotate(${turn}deg)` : undefined}
>
  <path d={d}></path>
</svg>
