---
import type { Shot } from "@/lib/projects"
import Fanout from "./Fanout.astro"

export interface Tile {
  href?: string
  slug: string
  title: string
  accent: string
  alt: string
  lead: string
  rest: string
  shot?: Shot
  note?: string
  wide?: boolean
  quiet?: boolean
  isNew?: boolean
  zoom?: number
}

interface Props {
  tiles: Tile[]
  variant: "home" | "project"
}

const { tiles, variant } = Astro.props

const sizes = {
  home: {
    one: "(min-width: 1600px) 21vw, (min-width: 960px) 31vw, 50vw",
    two: "(min-width: 1600px) 42vw, (min-width: 960px) 62vw, 100vw",
  },
  project: {
    one: "(min-width: 960px) 31vw, (min-width: 560px) 50vw, 100vw",
    two: "(min-width: 960px) 62vw, 100vw",
  },
}[variant]
---

<div class="wall" data-wall data-variant={variant}>
  {
    tiles.map(({ href, ...t }) => {
      const Box = href ? "a" : "div"
      return (
        <Box
          class="tile"
          href={href}
          data-project={t.slug}
          data-wide={t.wide ? "" : undefined}
          data-zoom={t.zoom}
          tabindex={t.quiet ? -1 : undefined}
          style={`--accent: ${t.accent}`}
        >
          <span
            class="media"
            style={`aspect-ratio: ${t.shot ? `${t.shot.width} / ${t.shot.height}` : "4 / 3"}`}
          >
            {t.shot ? (
              <img
                src={t.shot.thumb}
                srcset={t.shot.srcset}
                sizes={
                  t.shot.srcset ? (t.wide ? sizes.two : sizes.one) : undefined
                }
                width={t.shot.width}
                height={t.shot.height}
                alt={t.alt}
                loading="lazy"
                decoding="async"
                class:list={{ pixel: t.shot.small }}
              />
            ) : (
              <Fanout title={t.title} note={t.note ?? ""} />
            )}
            {t.isNew && (
              <span class="new tile-new" aria-hidden="true">
                New
              </span>
            )}
          </span>
          <span class="cap" aria-hidden="true">
            <span class="cap-lead">{t.lead}</span>
            <span class="cap-rest">{t.rest}</span>
            {href && (
              <span class="cap-arrow">{t.zoom === undefined ? "↗" : "+"}</span>
            )}
          </span>
        </Box>
      )
    })
  }
</div>

<style>
  .wall {
    --cols: 2;
    --row-gap: calc(var(--gap) * 2.2);
    columns: var(--cols);
    column-gap: var(--gap);
    row-gap: var(--row-gap);
  }

  .wall[data-variant="project"] {
    --cols: 1;
  }

  @media (min-width: 560px) {
    .wall[data-variant="project"] {
      --cols: 2;
    }
  }

  @media (min-width: 1600px) {
    .wall[data-variant="home"] {
      --cols: 3;
    }
  }

  .tile {
    position: relative;
    display: block;
    break-inside: avoid;
    margin-bottom: var(--row-gap);
    color: var(--fg-2);
    transition:
      opacity 0.5s var(--ease-out),
      filter 0.5s var(--ease-out);
  }

  .tile[data-wide] {
    column-span: all;
  }

  .wall.is-laid {
    position: relative;
    columns: auto;
  }

  .wall.is-laid .tile {
    position: absolute;
    margin: 0;
  }

  .tile.is-dim {
    opacity: 0.3;
    filter: grayscale(1);
  }

  .media {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 3px;
    background: color-mix(in oklab, var(--accent) 16%, var(--bg-2));
  }

  .media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }

  .media img.pixel {
    image-rendering: pixelated;
  }

  .tile:hover .media img,
  .tile:focus-visible .media img {
    transform: scale(1.03);
  }

  .tile:focus-visible {
    outline: none;
  }

  .tile:focus-visible .media {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }

  .tile-new {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #0c0c0bb3;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .cap {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    padding-top: 10px;
    font-size: 13px;
    line-height: 1.35;
    color: var(--muted);
  }

  .cap-lead {
    flex: none;
    font-weight: 560;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .cap-rest {
    min-width: 0;
  }

  .cap-arrow {
    margin-left: auto;
    color: var(--accent);
    opacity: 0;
    translate: -4px 0;
    transition:
      opacity 0.3s,
      translate 0.5s var(--ease-out);
  }

  .tile:hover .cap-arrow,
  .tile:focus-visible .cap-arrow {
    opacity: 1;
    translate: 0 0;
  }

  @media (hover: none) {
    .cap-arrow {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (max-width: 559px) {
    .wall[data-variant="home"] .cap {
      flex-wrap: wrap;
      column-gap: 0.3em;
      row-gap: 0;
      font-size: 12px;
    }

    .wall[data-variant="home"] .cap-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .wall.is-laid .tile:not(.is-in) .media {
      clip-path: inset(100% 0 0 0);
    }

    .wall.is-laid .tile:not(.is-in) .media img,
    .wall.is-laid .tile:not(.is-in) .media :global(.fanout) {
      transform: scale(1.18) translateY(-4%);
    }

    .wall.is-laid .tile:not(.is-in) .cap {
      opacity: 0;
      translate: 0 8px;
    }

    .wall.is-laid .media {
      clip-path: inset(0 0 0 0);
      transition: clip-path 1.1s var(--ease-out) var(--d, 0ms);
    }

    .wall.is-laid .media img,
    .wall.is-laid .media :global(.fanout) {
      transition: transform 1.4s var(--ease-out) var(--d, 0ms);
    }

    .wall.is-laid .tile.is-in:hover .media img {
      transition-delay: 0ms;
    }

    .wall.is-laid .cap {
      transition:
        opacity 0.8s var(--ease-out) calc(var(--d, 0ms) + 200ms),
        translate 0.8s var(--ease-out) calc(var(--d, 0ms) + 200ms);
    }
  }
</style>

<script>
  import { freeze, reduced } from "@/lib/freeze"

  const reveal = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue
        e.target.classList.add("is-in")
        reveal.unobserve(e.target)
      }
    },
    { rootMargin: "0px 0px -8% 0px" }
  )

  for (const wall of document.querySelectorAll<HTMLElement>("[data-wall]")) {
    const tiles = [...wall.querySelectorAll<HTMLElement>(".tile")]
    const medias = tiles.map((t) => t.querySelector<HTMLElement>(".media")!)
    let lastWidth = 0

    const layout = (force = false) => {
      const width = wall.clientWidth
      if (!force && width === lastWidth) return
      lastWidth = width
      const cs = getComputedStyle(wall)
      const cols = Math.max(1, parseInt(cs.getPropertyValue("--cols")) || 1)
      const gap = parseFloat(cs.columnGap) || 0
      const rowGap = parseFloat(cs.rowGap) || gap
      const colW = (width - gap * (cols - 1)) / cols
      const spans = tiles.map((t) =>
        t.hasAttribute("data-wide") ? Math.min(2, cols) : 1
      )
      tiles.forEach((t, i) => {
        t.style.width = `${colW * spans[i] + gap * (spans[i] - 1)}px`
        medias[i].style.height = ""
      })
      const heights = tiles.map((t) => t.offsetHeight)
      const mh = medias.map((m) => m.offsetHeight)
      const extra = tiles.map(() => 0)
      const tops = tiles.map(() => 0)
      const stacks = Array.from({ length: cols }, () => [] as number[])
      const last: number[] = []
      const at: number[] = []
      const ys = new Array<number>(cols).fill(0)
      const top = (col: number, span: number) =>
        Math.max(...ys.slice(col, col + span))
      const lowest = (span: number) => {
        let col = 0
        let best = Infinity
        for (let c = 0; c + span <= cols; c++) {
          const t = top(c, span)
          const score = ys
            .slice(c, c + span)
            .reduce((sum, y) => sum + 2 * (t - y), t)
          if (score < best - 1) {
            best = score
            col = c
          }
        }
        return col
      }
      const cost = (i: number) => heights[i] + rowGap
      const crop = 0.2
      const put = (i: number, col: number) => {
        const span = spans[i]
        tops[i] = top(col, span)
        tiles[i].style.left = `${col * (colW + gap)}px`
        tiles[i].style.setProperty("--d", `${col * 90}ms`)
        ys.fill(tops[i] + cost(i), col, col + span)
        at[i] = col
        for (let c = col; c < col + span; c++) {
          stacks[c] = span > 1 ? [] : [...stacks[c], i]
          last[c] = i
        }
      }
      const grow = (c: number, need: number) => {
        if (Math.abs(need) < 1) return
        const dir = Math.sign(need)
        const room = (j: number) => Math.max(0, mh[j] * crop - dir * extra[j])
        const w = last[c]
        if (w !== undefined && spans[w] > 1) {
          const span = [...Array(spans[w]).keys()].map((k) => at[w] + k)
          const take = Math.min(Math.abs(need), room(w))
          if (take < 1 || span.some((k) => last[k] !== w)) return
          extra[w] += dir * take
          span.forEach((k) => (ys[k] += dir * take))
          return
        }
        const tail = stacks[c].slice(-3)
        const rooms = tail.map(room)
        const total = rooms.reduce((a, b) => a + b, 0)
        if (total < 1) return
        const take = Math.min(Math.abs(need), total)
        let y = tops[tail[0]]
        tail.forEach((j, k) => {
          extra[j] += (dir * take * rooms[k]) / total
          tops[j] = y
          y += cost(j) + extra[j]
        })
        ys[c] = y
      }
      const level = (col: number, span: number) => {
        const region = [...Array(span).keys()].map((k) => col + k)
        const hi = Math.max(...region.map((c) => ys[c]))
        region.forEach((c) => grow(c, hi - ys[c]))
        const lo = Math.min(...region.map((c) => ys[c]))
        region.forEach((c) => grow(c, lo - ys[c]))
      }
      const finish = (rest: number[]) => {
        let best: number[] = []
        let score = Infinity
        const pick: number[] = []
        const walk = (k: number, h: number[]) => {
          if (k === rest.length) {
            const s = Math.max(...h) - Math.min(...h)
            if (s < score) {
              score = s
              best = [...pick]
            }
            return
          }
          for (let c = 0; c < cols; c++) {
            pick[k] = c
            walk(
              k + 1,
              h.map((y, n) => (n === c ? y + cost(rest[k]) : y))
            )
          }
          if (k === rest.length - 1 && cols > 1) {
            const t = Math.max(...h)
            const s = h.reduce((sum, y) => sum + t - y, colW * 0.25)
            if (s < score) {
              score = s
              best = [...pick.slice(0, k), -1]
            }
          }
        }
        walk(0, ys)
        rest.forEach((i, k) => {
          if (best[k] >= 0) return put(i, best[k])
          spans[i] = cols
          tiles[i].style.width = `${width}px`
          const img = tiles[i].querySelector("img")
          if (img?.sizes) img.sizes = `${width}px`
          heights[i] = tiles[i].offsetHeight
          mh[i] = medias[i].offsetHeight
          level(0, cols)
          put(i, 0)
        })
      }
      const queue = tiles.map((_, i) => i)
      while (queue.length) {
        if (queue.length <= 7 && queue.every((j) => spans[j] === 1)) {
          finish(queue)
          break
        }
        const i = queue.shift()!
        const span = spans[i]
        if (span > 1) {
          for (;;) {
            const col = lowest(span)
            let low = col
            for (let c = col; c < col + span; c++) if (ys[c] < ys[low]) low = c
            let hole = top(col, span) - ys[low]
            let pick = -1
            queue.slice(0, 6).forEach((j, k) => {
              const left = Math.abs(hole - cost(j))
              if (spans[j] === 1 && left < hole) {
                hole = left
                pick = k
              }
            })
            if (pick < 0) break
            put(queue.splice(pick, 1)[0], low)
          }
        }
        const col = lowest(span)
        level(col, span)
        put(i, col)
      }
      level(0, cols)
      tiles.forEach((t, i) => {
        t.style.top = `${tops[i]}px`
        if (extra[i]) medias[i].style.height = `${mh[i] + extra[i]}px`
      })
      wall.style.height = `${Math.max(...ys) - rowGap}px`
    }

    wall.classList.add("is-laid")
    layout(true)
    new ResizeObserver(() => layout()).observe(wall)
    document.fonts.ready.then(() => layout(true))
    tiles.forEach((t) => reveal.observe(t))

    if (reduced)
      wall
        .querySelectorAll<HTMLImageElement>('img[src$=".gif"]')
        .forEach(freeze)
  }
</script>
