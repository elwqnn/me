---
interface Props {
  mode?: "full" | "band"
  accent?: string
}

const { mode = "full", accent } = Astro.props
---

<div
  class="surface"
  data-surface={mode}
  data-accent={accent}
  style={accent ? `--accent: ${accent}` : undefined}
  aria-hidden="true"
>
  <canvas></canvas>
</div>

<style>
  .surface {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background:
      radial-gradient(
        90% 70% at 72% 36%,
        color-mix(in oklab, var(--accent) 9%, transparent),
        transparent 70%
      ),
      repeating-radial-gradient(
        circle at 72% 36%,
        transparent 0 38px,
        rgb(236 232 220 / 0.055) 38px 39px
      ),
      repeating-radial-gradient(
        circle at 18% 88%,
        transparent 0 52px,
        rgb(236 232 220 / 0.035) 52px 53px
      ),
      var(--bg);
  }

  .surface[data-surface="band"] {
    position: absolute;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }

  .surface[data-ready] canvas {
    opacity: 1;
  }
</style>

<script>
  import { mountSurface } from "./surface"

  document
    .querySelectorAll<HTMLElement>("[data-surface]")
    .forEach((root) => mountSurface(root))
</script>
