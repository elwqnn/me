---
import Wght from "./Wght.astro"

interface Props {
  title: string
  top: string
  bottom: string
  color: string
  class?: string
}

const { title, top, bottom, color, class: className } = Astro.props
---

<div class:list={["plate", className]} style={`--plate:${color}`}>
  <span class="row meta"><span>{top}</span></span>
  <Wght text={title} class="plate-title" />
  <span class="row meta"><span>{bottom}</span></span>
</div>

<style>
  .plate {
    container-type: size;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: clamp(12px, 5cqw, 28px);
    background: var(--plate);
    color: var(--ink);
    overflow: hidden;
  }

  .plate::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 calc(12.5cqh - 1px),
      rgb(21 21 20 / 0.12) calc(12.5cqh - 1px) 12.5cqh
    );
    pointer-events: none;
  }

  .row {
    position: relative;
    max-width: 30ch;
    font-size: clamp(10px, 5cqw, var(--meta));
  }

  @container (max-width: 240px) {
    .row:first-child {
      visibility: hidden;
    }
  }

  .plate :global(.plate-title) {
    position: relative;
    font-size: 30cqw;
    line-height: 0.8;
    letter-spacing: -0.04em;
    margin-left: -0.04em;
  }
</style>
