---
import type { CollectionEntry } from "astro:content"
import Plate from "./Plate.astro"
import { media } from "./media"

interface Props {
  projects: CollectionEntry<"projects">[]
}

const { projects } = Astro.props

const lead =
  "Elwann Guillemot writes Rust for the back end and designs the brands around it — lately "

const connectors: Record<string, [string, string]> = {
  "gpui-shell": ["", ", a Wayland shell drawn on the GPU, and "],
  scylla: ["", ", a CI/CD engine; also "],
  sonar: ["", ", a music recommender, "],
  topiq: ["", ", a small message broker, "],
  wfc: ["a ", " crate and, "],
  area: ["back in {year}, ", "."],
}

const ids = projects.map((p) => p.id)
const missing = ids.filter((id) => !(id in connectors))
const stale = Object.keys(connectors).filter((id) => !ids.includes(id))
if (missing.length || stale.length)
  throw new Error(
    `Hero sentence and projects differ. Missing: ${missing.join(", ") || "none"}. Stale: ${stale.join(", ") || "none"}.`
  )

const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;")

let w = 0
const words = (text: string) =>
  text
    .split(/(\s+)/)
    .filter(Boolean)
    .map((t) =>
      /^\s/.test(t)
        ? " "
        : `<span class="w" style="--i: ${w++}">${esc(t)}</span>`
    )
    .join("")

const sentence =
  words(lead) +
  projects
    .map((project, n) => {
      const { title, accentColor, isNew, year } = project.data
      const [before, after] = connectors[project.id]
      const link = `<a class="pl" href="/projects/${project.id}" data-peek="${project.id}" style="--accent: ${esc(accentColor ?? "var(--ink)")}; --n: ${n}">${words(title)}</a>`
      const badge = isNew ? `<sup class="new" style="--i: ${w}">New</sup>` : ""
      return words(before.replace("{year}", year)) + link + badge + words(after)
    })
    .join("")

const peeks = projects.map((p) => ({
  p,
  cover: p.data.images[0] ? media(p.data.images[0], p.id) : null,
}))
---

<section class="hero" aria-label="Introduction">
  <p class="hero-kicker label">Portfolio, {new Date().getFullYear()}</p>
  <h1 class="sentence" set:html={sentence} />
</section>

<div class="peek" aria-hidden="true">
  {
    peeks.map(({ p, cover }) => (
      <figure class="peek-item" data-for={p.id}>
        {cover ? (
          <img
            src={cover.src}
            width={cover.width}
            height={cover.height}
            alt=""
            decoding="async"
            class={cover.width < 1000 ? "pixel" : undefined}
          />
        ) : (
          <Plate
            title={p.data.title}
            description={p.data.description}
            tags={p.data.tags}
            accent={p.data.accentColor}
          />
        )}
      </figure>
    ))
  }
</div>

<script>
  const peek = document.querySelector<HTMLElement>(".peek")
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-peek]")
  const items = document.querySelectorAll<HTMLElement>(".peek-item")
  const fine = matchMedia("(hover: hover) and (pointer: fine)")
  const calm = matchMedia("(prefers-reduced-motion: reduce)")

  if (peek) {
    let x = 0
    let y = 0
    let tx = 0
    let ty = 0
    let r = 0
    let raf = 0
    let open = false
    let timer = 0

    const target = (px: number, py: number, top = py) => {
      const w = peek.offsetWidth
      const h = peek.offsetHeight
      const gap = 32
      tx = Math.max(16, Math.min(px + gap * 0.75, innerWidth - w - 16))
      ty = py + gap + h > innerHeight - 16 ? top - gap - h : py + gap
    }

    const frame = () => {
      const k = calm.matches ? 1 : 0.14
      const dx = tx - x
      x += dx * k
      y += (ty - y) * k
      const lean = calm.matches ? 0 : Math.max(-6, Math.min(6, dx * 0.035))
      r += (lean - r) * 0.1
      peek.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${r}deg)`
      const moving =
        Math.abs(dx) > 0.2 || Math.abs(ty - y) > 0.2 || Math.abs(r) > 0.02
      raf = open || moving ? requestAnimationFrame(frame) : 0
    }

    const show = (id: string, snap: boolean) => {
      clearTimeout(timer)
      if (!open || snap) {
        x = tx
        y = ty
        r = 0
      }
      open = true
      items.forEach((el) => el.classList.toggle("on", el.dataset.for === id))
      if (!raf) raf = requestAnimationFrame(frame)
    }

    let focused: HTMLAnchorElement | null = null
    let settle = 0

    const place = (link: HTMLAnchorElement) => {
      const rect = link.getBoundingClientRect()
      target(rect.left, rect.bottom - 16, rect.top + 16)
      show(link.dataset.peek ?? "", true)
    }

    const hide = () => {
      timer = window.setTimeout(() => {
        open = false
        items.forEach((el) => el.classList.remove("on"))
      }, 60)
    }

    links.forEach((link) => {
      const id = link.dataset.peek ?? ""
      link.addEventListener("pointerenter", (e) => {
        if (!fine.matches) return
        target(e.clientX, e.clientY)
        show(id, false)
      })
      link.addEventListener("pointermove", (e) => {
        if (!fine.matches) return
        target(e.clientX, e.clientY)
        if (!open) show(id, false)
      })
      link.addEventListener("pointerleave", hide)
      link.addEventListener("focus", () => {
        if (!link.matches(":focus-visible")) return
        focused = link
        place(link)
      })
      link.addEventListener("blur", () => {
        focused = null
        hide()
      })
    })

    addEventListener(
      "scroll",
      () => {
        if (open && [...links].some((l) => l.matches(":hover"))) hide()
        if (!focused) return
        clearTimeout(settle)
        settle = window.setTimeout(() => {
          if (focused) place(focused)
        }, 120)
      },
      { passive: true }
    )
  }
</script>

<style>
  .hero {
    --top: clamp(3.5rem, 9vw, 8.5rem);
    --fs: clamp(2.125rem, 0.6rem + 4.9vw, 5.25rem);
    --lh: 1.06;
    position: relative;
    padding: var(--top) var(--gutter) clamp(4rem, 10vw, 9rem);
  }

  .hero-kicker {
    position: absolute;
    left: var(--gutter);
    top: var(--top);
    height: calc(var(--fs) * var(--lh));
    display: flex;
    align-items: center;
  }

  .sentence {
    font-family: var(--serif);
    font-weight: 330;
    font-size: var(--fs);
    line-height: var(--lh);
    letter-spacing: -0.022em;
    text-indent: calc(
      (100% - 11 * var(--col-gap)) / 12 * 3 + 3 * var(--col-gap)
    );
    text-wrap: pretty;
    max-width: 21em;
    font-feature-settings: "kern", "liga", "onum";
  }

  .sentence :global(.w) {
    animation: ink 1.3s var(--ease-out) backwards;
    animation-delay: calc(0.12s + var(--i) * 24ms);
  }

  @keyframes ink {
    from {
      opacity: 0;
      filter: blur(12px);
    }
  }

  .sentence :global(.pl) {
    text-decoration-line: underline;
    text-decoration-thickness: 0.045em;
    text-underline-offset: 0.12em;
    text-decoration-skip-ink: auto;
    text-decoration-color: var(--ink-soft);
    transition:
      opacity 0.6s var(--ease-out),
      text-decoration-color 0.45s var(--ease-out),
      text-decoration-thickness 0.45s var(--ease-out);
    animation: rule 1.1s var(--ease-out) backwards;
    animation-delay: calc(1.1s + var(--n) * 110ms);
  }

  @keyframes rule {
    from {
      text-decoration-color: transparent;
    }
  }

  .sentence :global(.pl:hover),
  .sentence :global(.pl:focus-visible) {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 0.08em;
  }

  .sentence :global(.pl:focus-visible) {
    outline-offset: 0.08em;
  }

  .sentence :global(.new) {
    margin-left: 0.18em;
    padding: 0.32rem 0.45rem 0.28rem;
    font-family: var(--sans);
    font-size: clamp(0.5625rem, 0.4rem + 0.35vw, 0.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    vertical-align: calc(var(--fs) * 0.42);
    border: 1px solid currentColor;
    border-radius: 99px;
    animation: ink 1.3s var(--ease-out) backwards;
    animation-delay: calc(0.12s + var(--i) * 24ms);
  }

  @media (hover: hover) {
    .sentence > :global(.w),
    .sentence > :global(.new) {
      transition: opacity 0.6s var(--ease-out);
    }

    .sentence:global(:has(.pl:hover)) > :global(.w),
    .sentence:global(:has(.pl:hover)) > :global(.new),
    .sentence:global(:has(.pl:hover)) > :global(.pl:not(:hover)) {
      opacity: 0.2;
    }
  }

  .peek {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: clamp(15rem, 23vw, 24rem);
    aspect-ratio: 4 / 3;
    pointer-events: none;
    will-change: transform;
  }

  .peek-item {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--paper-deep);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.55s var(--ease-in-out);
  }

  .peek-item.on {
    z-index: 1;
    clip-path: inset(0 0 0 0);
    transition-duration: 0.7s;
    transition-timing-function: var(--ease-out);
  }

  .peek-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.18;
    transition: scale 1.1s var(--ease-out);
  }

  .peek-item.on img {
    scale: 1;
  }

  @media (max-width: 47.99rem) {
    .hero-kicker {
      position: static;
      height: auto;
      margin-bottom: 1.25rem;
    }

    .sentence {
      text-indent: 0;
    }
  }

  @media (hover: none) {
    .peek {
      display: none;
    }
  }
</style>
