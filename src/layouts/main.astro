---
import "@/styles/global.css"
import Wipe from "@/components/Wipe.astro"
import Arrow from "@/components/Arrow.astro"
import doto from "@fontsource-variable/doto/files/doto-latin-full-normal.woff2?url"
import geist from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url"

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = "Elwann Guillemot",
  description = "Back-end developer focused on performance and user experience. Currently studying abroad at Hanze University in Groningen.",
  image,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImage = image?.replace(/#wide$/, "")
const year = new Date().getFullYear()
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ece9e1" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preload" href={doto} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Elwann Guillemot" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {
      ogImage && (
        <meta property="og:image" content={new URL(ogImage, Astro.site)} />
      )
    }

    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      ogImage && (
        <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
      )
    }

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Elwann Guillemot",
        url: "https://me.elwqnn.eu",
        jobTitle: "Back-end Developer",
        sameAs: [
          "https://github.com/Elwqnn",
          "https://www.linkedin.com/in/elwannguillemot/",
        ],
      })}
    />

    <script is:inline>
      document.documentElement.classList.add("js")
    </script>
  </head>
  <body>
    <div class="sheet stack min-h-[calc(100dvh-2*clamp(8px,1.4vw,20px))]">
      <slot />
      <footer class="row label mt-auto grid-cols-2 md:grid-cols-12">
        <p class="cell md:col-span-3">&copy; {year} Elwann Guillemot</p>
        <p class="cell md:col-span-3">Set in Doto &amp; Geist Mono</p>
        <p class="cell hidden md:col-span-4 md:block">
          Two tones, one bit, Atkinson &amp; Bayer
        </p>
        <a
          href="#top"
          class="cell cell-link invert-hover col-span-2 flex items-center justify-between gap-2"
        >
          Back to top <Arrow dir="up" size={10} />
        </a>
      </footer>
    </div>
    <Wipe />
  </body>
</html>
