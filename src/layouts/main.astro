---
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = "Elwann Guillemot",
  description = "Back-end developer focused on performance and user experience. Currently studying abroad at Hanze University in Groningen.",
  image,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const nav = [
  { id: "work", label: "Work" },
  { id: "about", label: "About" },
  { id: "contact", label: "Contact" },
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c0c0b" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Elwann Guillemot" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}

    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      image && (
        <meta name="twitter:image" content={new URL(image, Astro.site)} />
      )
    }

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Elwann Guillemot",
        url: "https://me.elwqnn.eu",
        jobTitle: "Back-end Developer",
        sameAs: [
          "https://github.com/Elwqnn",
          "https://www.linkedin.com/in/elwannguillemot/",
        ],
      })}
    />

    <script is:inline>
      document.documentElement.classList.add("js")
    </script>
  </head>
  <body>
    <nav class="pill" aria-label="Primary" data-pill>
      <span class="pill-thumb" aria-hidden="true"></span>
      {
        nav.map(({ id, label }) => (
          <a href={`/#${id}`} data-nav={id}>
            {label}
          </a>
        ))
      }
    </nav>
    <slot />
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>

<style>
  .pill {
    position: fixed;
    left: 50%;
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 50;
    display: flex;
    gap: 2px;
    padding: 5px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: color-mix(in oklab, #1d1d1b 72%, transparent);
    box-shadow:
      0 1px 0 0 #ffffff12 inset,
      0 18px 40px -12px #000000cc;
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    translate: -50% 0;
    isolation: isolate;
  }

  .pill a {
    position: relative;
    z-index: 1;
    padding: 9px 18px 10px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 520;
    font-stretch: 108%;
    line-height: 1;
    letter-spacing: 0.005em;
    color: var(--fg-2);
    transition: color 0.3s var(--ease-out);
  }

  .pill a:hover {
    color: var(--fg);
  }

  .pill a.is-under {
    color: var(--bg);
  }

  .pill a:focus-visible {
    outline-offset: 1px;
    border-radius: 999px;
  }

  .pill-thumb {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: 0;
    width: var(--w, 0px);
    border-radius: 999px;
    background: var(--fg);
    translate: var(--x, 0px) 0;
    opacity: 0;
  }

  .pill.is-ready .pill-thumb {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pill.is-ready .pill-thumb {
      transition:
        translate 0.55s var(--ease-spring),
        width 0.55s var(--ease-spring),
        opacity 0.3s;
    }

    .pill {
      animation: pill-in 0.9s var(--ease-out) 0.5s both;
    }

    @keyframes pill-in {
      from {
        opacity: 0;
        translate: -50% 140%;
      }
    }
  }

  @media (max-width: 420px) {
    .pill a {
      padding: 9px 15px 10px;
    }
  }
</style>

<script>
  const pill = document.querySelector<HTMLElement>("[data-pill]")!
  const thumb = pill.querySelector<HTMLElement>(".pill-thumb")!
  const links = [...pill.querySelectorAll<HTMLAnchorElement>("[data-nav]")]
  const sections = links
    .map((a) => document.getElementById(a.dataset.nav!))
    .filter((s): s is HTMLElement => !!s)

  let active = "work"
  let hover: string | null = null

  const place = () => {
    const id = hover ?? active
    for (const a of links) {
      const on = a.dataset.nav === id
      a.classList.toggle("is-under", on)
      if (on) {
        thumb.style.setProperty("--x", `${a.offsetLeft}px`)
        thumb.style.setProperty("--w", `${a.offsetWidth}px`)
      }
      if (a.dataset.nav === active) a.setAttribute("aria-current", "true")
      else a.removeAttribute("aria-current")
    }
  }

  for (const a of links) {
    a.addEventListener("pointerenter", () => {
      hover = a.dataset.nav!
      place()
    })
  }
  pill.addEventListener("pointerleave", () => {
    hover = null
    place()
  })

  if (sections.length) {
    let ticking = false
    const track = () => {
      ticking = false
      const atEnd =
        innerHeight + scrollY >= document.documentElement.scrollHeight - 4
      let id = sections[0].id
      for (const s of sections) {
        if (s.getBoundingClientRect().top < innerHeight * 0.55) id = s.id
      }
      if (atEnd) id = sections[sections.length - 1].id
      if (id !== active) {
        active = id
        place()
      }
    }
    addEventListener(
      "scroll",
      () => {
        if (!ticking) requestAnimationFrame(track)
        ticking = true
      },
      { passive: true }
    )
    track()
  }

  place()
  document.fonts.ready.then(place)
  requestAnimationFrame(() => pill.classList.add("is-ready"))

  const side = document.querySelector<HTMLElement>(".side")
  if (side) {
    const stick = () =>
      side.style.setProperty(
        "--stick",
        `${Math.min(0, innerHeight - side.offsetHeight)}px`
      )
    new ResizeObserver(stick).observe(side)
    addEventListener("resize", stick)
  }
</script>
