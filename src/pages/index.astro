---
import { getCollection } from "astro:content"
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import Reading, { type Segment } from "@/components/Reading.astro"
import ProjectIndex from "@/components/ProjectIndex.astro"

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
)

const today: Segment[] = [
  "I spent my fourth year abroad at the ",
  {
    text: "Hanze University of Applied Sciences",
    href: "https://www.hanze.nl/en",
  },
  " in Groningen, Netherlands. Now I’m back at ",
  { text: "Aktislab", href: "https://www.aktislab.fr/" },
  " in Lyon, France, for my final year. Most of my time goes into building tools that make my life, and anyone else’s, a little easier and more enjoyable. Things that feel fast and leave room for the ",
  { text: "person using them", em: true },
  ".",
]

const contact: Segment[] = [
  "Feel free to reach out if you’re looking to collaborate on a project, have a job opportunity, or just want to connect.",
]

const channels = [
  {
    label: "Email me at",
    text: "elwann.guillemot@epitech.eu",
    href: "mailto:elwann.guillemot@epitech.eu",
    icon: "→",
  },
  {
    label: "On GitHub",
    text: "@elwqnn",
    href: "https://github.com/elwqnn",
    icon: "↗",
    external: true,
  },
  {
    label: "Or check out my",
    text: "Resume",
    href: "/documents/elwann_guillemot_resume.pdf",
    icon: "↓",
  },
]
---

<Layout>
  <SiteHeader home />
  <main>
    <section class="today wrap" aria-labelledby="today-title">
      <Reading no="01" label="Today" segments={today} counter>
        <h1 id="today-title" class="intro">
          <span data-scramble data-scramble-delay="140">Elwann Guillemot</span>
          <span class="role" data-scramble data-scramble-delay="320"
            >Back-end Developer</span
          >
        </h1>
      </Reading>
    </section>

    <ProjectIndex projects={projects} />

    <section id="contact" class="contact wrap" aria-label="Contact">
      <Reading no="03" label="Contact" segments={contact} />
      <ul class="channels">
        {
          channels.map((c, i) => (
            <li style={`--i: ${i}`}>
              <a
                class="channel grid"
                href={c.href}
                {...(c.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                <span class="c-label mono dim">{c.label}</span>
                <span class="c-text">
                  <span data-scramble>{c.text}</span>
                </span>
                <span class="c-icon" aria-hidden="true">
                  {c.icon}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <SiteFooter />
</Layout>

<style>
  .today {
    padding-top: clamp(72px, 15vh, 180px);
  }

  .intro {
    font-size: var(--fs-read);
    font-weight: 480;
    line-height: 1.1;
    letter-spacing: -0.034em;
    margin-bottom: 0.7em;
  }

  .intro span {
    display: block;
    width: fit-content;
  }

  .contact {
    margin-top: clamp(140px, 18vw, 260px);
    scroll-margin-top: 32px;
  }

  .channels {
    margin-top: clamp(56px, 7vw, 104px);
    border-top: 1px solid var(--rule);
  }

  .channel {
    position: relative;
    align-items: baseline;
    padding-block: clamp(18px, 2.2vw, 30px);
    border-bottom: 1px solid var(--rule);
    outline-offset: 6px;
  }

  .channel::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s var(--ease-out);
  }

  .c-label {
    grid-column: 1 / 4;
  }

  .c-text {
    grid-column: 4 / 12;
    font-size: clamp(22px, 3.4vw, 52px);
    font-weight: 440;
    line-height: 1.05;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    transition: transform 0.7s var(--ease-out);
  }

  .c-icon {
    grid-column: 12 / 13;
    justify-self: end;
    font-size: clamp(20px, 2.4vw, 36px);
    line-height: 1;
    color: var(--fg-3);
    transition:
      transform 0.6s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  .channel:hover::after,
  .channel:focus-visible::after {
    transform: none;
  }

  .channel:hover .c-text,
  .channel:focus-visible .c-text {
    transform: translateX(14px);
  }

  .channel:hover .c-icon,
  .channel:focus-visible .c-icon {
    color: var(--fg);
    transform: translateX(-6px);
  }

  @media (prefers-reduced-motion: reduce) {
    .channel::after,
    .c-text,
    .c-icon {
      transition: none;
    }
  }

  @media (max-width: 899px) {
    .channel {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 8px;
    }

    .c-label {
      grid-column: 1 / -1;
    }

    .c-text {
      grid-column: 1;
    }

    .c-icon {
      grid-column: 2;
    }
  }
</style>
