---
import Layout from "@/layouts/main.astro"
import Arrow from "@/components/Arrow.astro"
import Contact from "@/components/Contact.astro"
import Cover from "@/components/Cover.astro"
import Marquee from "@/components/Marquee.astro"
import Sticker from "@/components/Sticker.astro"
import {
  HOME_BG,
  cleanSrc,
  getProjects,
  pad,
  titleLines,
} from "@/components/projects"

const projects = await getProjects()
const allTags = [...new Set(projects.flatMap((p) => p.data.tags))]
const half = Math.ceil(allTags.length / 2)
const bandB = [...allTags.slice(half), ...allTags.slice(0, half)]
const nameLines = [
  { word: "Elwann", width: 7.4 },
  { word: "Guillemot", width: 9.5 },
].map(({ word, width }, line) => ({
  width,
  chars: [...word].map((char, i) => ({ char, i: i + line * 6 })),
}))
---

<Layout>
  <header
    id="top"
    class="hero"
    data-fit-screen
    data-bg={HOME_BG}
    style={`--section: ${HOME_BG}`}
  >
    <nav class="topbar" aria-label="Main">
      <a href="/" class="topbar__mark" aria-label="Elwann Guillemot, home">EG</a
      >
      <span class="topbar__meta">Back-end Developer</span>
      <span class="topbar__meta">Lyon, France</span>
      <ul class="topbar__nav">
        <li><a href="#today">Today</a></li>
        <li><a href="#work">Work</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>

    <h1 class="hero__name">
      <span class="sr-only">Elwann Guillemot</span>
      {
        nameLines.map(({ width, chars }) => (
          <span class="hero__line fit-box" aria-hidden="true">
            <span class="fit" data-fit style={`--n: ${width}`}>
              {chars.map(({ char, i }) => (
                <span class="char" style={`--i: ${i}`}>
                  {char}
                </span>
              ))}
            </span>
          </span>
        ))
      }
    </h1>

    <div class="spin" aria-hidden="true">
      <svg viewBox="0 0 200 200">
        <defs>
          <path
            id="spin-path"
            d="M100,100 m-76,0 a76,76 0 1,1 152,0 a76,76 0 1,1 -152,0"></path>
        </defs>
        <circle cx="100" cy="100" r="97"></circle>
        <g class="spin__ring">
          <text>
            <textPath href="#spin-path" textLength="470">
              Back-end developer ✦ Mostly Rust ✦ Lyon, FR ✦
            </textPath>
          </text>
        </g>
      </svg>
      <span class="spin__core">✦</span>
    </div>

    <div class="hero__row">
      <p class="hero__role">Back-end <br />Developer</p>
      <p class="hero__blurb">
        Mostly Rust. Engines, brokers and desktop shells that stay out of your
        way, and the odd brand identity on the side.
      </p>
      <a class="hero__down" href="#work">
        <span>{pad(projects.length)} projects</span>
        <Arrow class="arrow--down" />
      </a>
    </div>
  </header>

  <div class="bands">
    <Marquee items={bandB} class="band band--paper" reverse speed={60} />
    <Marquee items={allTags} class="band band--ink" speed={48} />
  </div>

  <section
    id="today"
    class="today"
    data-bg={HOME_BG}
    style={`--section: ${HOME_BG}`}
  >
    <h2 class="label"><span>(01)</span> Today</h2>
    <p class="today__text">
      I spent my fourth year abroad at the <a
        href="https://www.hanze.nl/en"
        target="_blank"
        rel="noopener noreferrer">Hanze University of Applied Sciences</a
      > in Groningen, Netherlands. Now I'm back at <a
        href="https://www.aktislab.fr/"
        target="_blank"
        rel="noopener noreferrer">Aktislab</a
      > in Lyon, France, for my final year. Most of my time goes into building tools
      that make my life, and anyone else's, a little easier and more enjoyable. Things
      that feel fast and leave room for the <span class="stamp"
        >person using them</span
      >.
    </p>
  </section>

  <section
    id="work"
    class="work"
    data-bg={HOME_BG}
    style={`--section: ${HOME_BG}`}
    aria-labelledby="work-title"
  >
    <p class="label"><span>(02)</span> Selected work</p>
    <h2 id="work-title" class="work__title fit-box">
      <span class="fit" data-fit style="--n: 12">Things I built</span>
    </h2>
    <div class="work__sub">
      <p class="work__note">
        {pad(projects.length)} projects, the most interesting ones imo.
      </p>
      <ol class="index">
        {
          projects.map((p, i) => (
            <li>
              <a
                href={`#${p.id}`}
                style={`--dot: ${p.data.accentColor ?? HOME_BG}`}
              >
                <span class="index__num">{pad(i + 1)}</span>
                {p.data.title}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    projects.map((p, i) => {
      const { title, description, tags, images, year, isNew } = p.data
      const accent = p.data.accentColor ?? HOME_BG
      const href = `/projects/${p.id}`
      const cover = images[0] ? cleanSrc(images[0]) : undefined
      return (
        <article
          id={p.id}
          class:list={["poster", { "poster--flip": i % 2 === 1 }]}
          data-bg={accent}
          style={`--section: ${accent}; --rot: ${i % 2 ? 1.4 : -1.4}deg`}
          aria-labelledby={`${p.id}-title`}
        >
          <div class="poster__meta">
            <span>No. {pad(i + 1)}</span>
            <span class="poster__rule" />
            <span>
              {isNew ? "New, " : ""}
              {year}
            </span>
          </div>
          <h3 id={`${p.id}-title`} class="poster__title">
            <a href={href} tabindex="-1">
              {titleLines(title).map((line) => (
                <span class="poster__line fit-box">
                  <span
                    class="fit"
                    data-fit
                    style={`--n: ${line.length}; --cap: 62vh`}
                  >
                    {line}
                  </span>
                </span>
              ))}
            </a>
          </h3>
          <div class="poster__body">
            <div class="poster__card" data-tilt>
              <a class="tilt" href={href} tabindex="-1">
                <span class="tilt__frame">
                  <Cover
                    src={cover}
                    title={title}
                    tags={tags}
                    accent={accent}
                  />
                </span>
                {isNew && <Sticker class="poster__sticker" />}
              </a>
            </div>
            <div class="poster__info">
              <span class="poster__num" aria-hidden="true">
                {pad(i + 1)}
              </span>
              <p class="poster__desc">{description}</p>
              <ul class="chips" aria-label="Stack">
                {tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <a class="cta" href={href}>
                View project<span class="sr-only">: {title}</span>
                <Arrow />
              </a>
            </div>
          </div>
        </article>
      )
    })
  }

  <Contact number="03" />
</Layout>
