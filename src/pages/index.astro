---
import { getCollection } from "astro:content"
import Layout from "@/layouts/main.astro"
import Topbar from "@/components/Topbar.astro"
import Scrap from "@/components/Scrap.astro"
import Stamp from "@/components/Stamp.astro"
import Tear from "@/components/Tear.astro"
import Label from "@/components/Label.astro"
import { pad } from "@/components/paper"

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
)
const bySlug = new Map(projects.map((p) => [p.id, p]))

type Slot = {
  side: "l" | "r"
  gap: number
  y: number
  w: number
  r: number
  speed: number
  tape?: boolean
  look?: "print" | "rip"
  over?: boolean
}

const place = (s: Slot, edge: string) =>
  `${s.side === "l" ? "right" : "left"}:calc(${edge} + ${s.gap}px);top:${s.y}px`
const fit = (s: Slot) =>
  `min(${s.w}px, calc(50vw - var(--sheet-w) / 2 - ${Math.max(s.gap, 0) + 20}px))`

const heroSlots: (Slot & { slug: string; i: number })[] = [
  {
    slug: "scylla",
    i: 6,
    side: "l",
    gap: 96,
    y: 40,
    w: 236,
    r: -5,
    speed: 0.16,
    tape: true,
    look: "print",
    over: true,
  },
  {
    slug: "gpui-shell",
    i: 3,
    side: "r",
    gap: -44,
    y: -6,
    w: 204,
    r: 6,
    speed: 0.3,
    look: "rip",
  },
  {
    slug: "scylla",
    i: 2,
    side: "r",
    gap: 92,
    y: 236,
    w: 262,
    r: -3.5,
    speed: 0.1,
    tape: true,
    look: "print",
    over: true,
  },
  {
    slug: "sonar",
    i: 2,
    side: "l",
    gap: -36,
    y: 452,
    w: 250,
    r: 3,
    speed: 0.06,
    look: "rip",
  },
  {
    slug: "area",
    i: 4,
    side: "r",
    gap: 40,
    y: 560,
    w: 232,
    r: 5.5,
    speed: 0.22,
    look: "rip",
    over: true,
  },
  {
    slug: "gpui-shell",
    i: 4,
    side: "l",
    gap: 150,
    y: 690,
    w: 212,
    r: -7,
    speed: 0.28,
    look: "print",
    over: true,
  },
]

const hero = heroSlots.flatMap((s) => {
  const p = bySlug.get(s.slug)
  const src = p?.data.images[s.i]
  return p && src ? [{ ...s, p, src }] : []
})

const workSlots: (Slot & { second?: Slot })[] = [
  {
    side: "r",
    gap: 34,
    y: -18,
    w: 292,
    r: 3.5,
    speed: 0.12,
    tape: true,
    look: "print",
    second: {
      side: "l",
      gap: 64,
      y: 54,
      w: 176,
      r: -6,
      speed: 0.24,
      look: "rip",
    },
  },
  {
    side: "l",
    gap: 28,
    y: -6,
    w: 300,
    r: -4,
    speed: 0.1,
    look: "rip",
    second: {
      side: "r",
      gap: 112,
      y: 64,
      w: 190,
      r: 7,
      speed: 0.2,
      tape: true,
      look: "print",
    },
  },
  {
    side: "r",
    gap: 62,
    y: 6,
    w: 280,
    r: -2.5,
    speed: 0.16,
    tape: true,
    look: "print",
    second: {
      side: "l",
      gap: 40,
      y: 46,
      w: 204,
      r: 5,
      speed: 0.08,
      look: "rip",
    },
  },
  { side: "l", gap: 70, y: -36, w: 220, r: 5, speed: 0.14 },
  {
    side: "r",
    gap: 44,
    y: -14,
    w: 214,
    r: -5,
    speed: 0.2,
    tape: true,
    look: "print",
  },
  {
    side: "l",
    gap: 30,
    y: 4,
    w: 300,
    r: 3,
    speed: 0.1,
    look: "rip",
    second: {
      side: "r",
      gap: 76,
      y: 34,
      w: 200,
      r: -4,
      speed: 0.22,
      tape: true,
      look: "print",
    },
  },
]

const hello = "Hello.".split("")
const now = new Date().getFullYear()
---

<Layout>
  <Topbar />
  <main class="desk">
    <div class="hero-scraps">
      {
        hero.map((s, k) => (
          <Scrap
            class:list={["hero-scrap", `hs-${k + 1}`, { over: s.over }]}
            seed={`hero-${k}`}
            src={s.src}
            alt={`${s.p.data.title} visual`}
            href={`/projects/${s.p.id}`}
            width={fit(s)}
            rotate={s.r}
            speed={s.speed}
            look={s.look}
            tape={s.tape}
            eager
            style={place(s, "50% + var(--sheet-w) / 2")}
          />
        ))
      }
      <p class="note" aria-hidden="true">
        <span>↖</span> psst, these scraps move. Try dragging one around.
      </p>
    </div>

    <article class="sheet">
      <Tear seed="home-top" />

      <section class="hero">
        <h1 class="hello serif">
          <span class="sr-only">Hello.</span>
          <span aria-hidden="true">
            {
              hello.map((c, i) => (
                <span class:list={{ dot: c === "." }} style={`--i:${i}`}>
                  {c}
                </span>
              ))
            }
          </span>
        </h1>
        <p class="lede">
          I'm <strong>Elwann Guillemot</strong>. I build back‑ends, mostly in
          <span class="circled"
            >Rust<svg
              viewBox="0 0 100 50"
              preserveAspectRatio="none"
              aria-hidden="true"
              ><path
                pathLength="1"
                d="M62 6C38 2 8 8 4 24s28 23 52 22 41-7 40-21S70 1 40 6"
              ></path></svg
            ></span
          >, and I design the visuals and brands that go around them.
        </p>
        <p class="role mono">
          <span>Back-end Developer</span>
          <span>Lyon, France</span>
        </p>
      </section>

      <section class="block" aria-labelledby="today">
        <Label n="01" id="today">Today</Label>
        <p class="today">
          I spent my fourth year abroad at the <a
            href="https://www.hanze.nl/en"
            class="ink-link"
            target="_blank"
            rel="noopener noreferrer">Hanze University of Applied Sciences</a
          > in Groningen, Netherlands. Now I'm back at <a
            href="https://www.aktislab.fr/"
            class="ink-link"
            target="_blank"
            rel="noopener noreferrer">Aktislab</a
          > in Lyon, France, for my final year. Most of my time goes into building
          tools that make my life, and anyone else's, a little easier and more enjoyable.
          Things that feel fast and leave room for the <em>person using them</em
          >.
        </p>
      </section>

      <section class="block" aria-labelledby="work">
        <Label n="02" id="work"
          >Selected work <span class="imo"
            >(the most interesting ones imo!)</span
          ></Label
        >
        <ol class="work-list">
          {
            projects.map((p, i) => {
              const slot = workSlots[i % workSlots.length]
              const { title, description, tags, images, year, isNew } = p.data
              const accent = p.data.accentColor ?? "var(--orange)"
              const second = slot.second && images[1] ? slot.second : undefined
              return (
                <li class="work lift" style={`--accent:${accent}`}>
                  <a class="work-link" href={`/projects/${p.id}`}>
                    <span class="work-meta mono">
                      <span class="work-n">{pad(i + 1)}</span>
                      <span class="chip" aria-hidden="true" />
                      <span>{year}</span>
                      {isNew && <span class="new">New</span>}
                    </span>
                    <span class="work-title serif">
                      <span class="marker">{title}</span>
                      <span class="arrow" aria-hidden="true">
                        →
                      </span>
                    </span>
                    <span class="work-desc">{description}</span>
                    <span class="work-tags mono">{tags.join(" · ")}</span>
                  </a>
                  {images[0] ? (
                    <Scrap
                      class:list={["work-scrap", "main", slot.side]}
                      seed={`${p.id}-main`}
                      src={images[0]}
                      alt={`${title} cover`}
                      href={`/projects/${p.id}`}
                      width={fit(slot)}
                      rotate={slot.r}
                      speed={slot.speed}
                      look={slot.look}
                      tape={slot.tape}
                      isNew={isNew}
                      style={place(slot, "100% + var(--pad)")}
                    />
                  ) : (
                    <Scrap
                      class:list={[
                        "work-scrap",
                        "main",
                        "stamp-scrap",
                        slot.side,
                      ]}
                      seed={`${p.id}-stamp`}
                      href={`/projects/${p.id}`}
                      width={fit(slot)}
                      rotate={slot.r}
                      speed={slot.speed}
                      isNew={isNew}
                      style={place(slot, "100% + var(--pad)")}
                    >
                      <Stamp
                        id={`home-${p.id}`}
                        title={title}
                        accent={accent}
                        number={pad(i + 1)}
                        year={year}
                        tags={tags}
                        mark={
                          new URL(
                            p.data.liveUrl ??
                              p.data.githubUrl ??
                              "https://github.com"
                          ).hostname
                        }
                      />
                    </Scrap>
                  )}
                  {second && (
                    <Scrap
                      class:list={["work-scrap", "second", second.side]}
                      seed={`${p.id}-second`}
                      src={images[1]}
                      alt={`${title} visual`}
                      href={`/projects/${p.id}`}
                      width={fit(second)}
                      rotate={second.r}
                      speed={second.speed}
                      look={second.look}
                      tape={second.tape}
                      style={place(second, "100% + var(--pad)")}
                    />
                  )}
                </li>
              )
            })
          }
        </ol>
      </section>

      <section class="block" aria-labelledby="contact">
        <Label n="03" id="contact">Contact</Label>
        <p class="contact-lede">
          Feel free to reach out if you're looking to collaborate on a project,
          have a job opportunity, or just want to connect.
        </p>
        <ul class="contact-list">
          <li>
            <span class="k mono">Email me at</span>
            <a class="v serif" href="mailto:elwann.guillemot@epitech.eu"
              ><span class="marker">elwann.guillemot@epitech.eu</span></a
            >
          </li>
          <li>
            <span class="k mono">On GitHub</span>
            <a
              class="v serif"
              href="https://github.com/elwqnn"
              target="_blank"
              rel="noopener noreferrer"
              ><span class="marker">@elwqnn</span>
              <span class="arr" aria-hidden="true">↗</span></a
            >
          </li>
          <li>
            <span class="k mono">Or check out my</span>
            <a class="v serif" href="/documents/elwann_guillemot_resume.pdf"
              ><span class="marker">resume</span>
              <span class="arr" aria-hidden="true">↓</span></a
            >
          </li>
        </ul>
      </section>

      <footer class="colophon mono">
        <span>© {now} Elwann Guillemot</span>
        <a href="#">Back to top ↑</a>
        <span>Set in Instrument Serif, Geist &amp; Geist Mono</span>
      </footer>

      <Tear seed="home-bottom" edge="bottom" />
    </article>
  </main>
</Layout>

<style>
  .desk {
    padding-top: 128px;
  }

  .hero-scraps :global(.hero-scrap) {
    position: absolute;
  }

  .hero-scraps :global(.hero-scrap.over) {
    z-index: 1;
  }

  .note {
    position: absolute;
    top: 470px;
    left: calc(50% + var(--sheet-w) / 2 + 118px);
    width: 190px;
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 19px;
    line-height: 1.2;
    color: var(--ink-3);
    rotate: -4deg;
  }

  .note span {
    font-family: var(--sans);
    font-style: normal;
    color: var(--orange-ink);
  }

  @media (max-width: 1359px), (hover: none), (pointer: coarse) {
    .note {
      display: none;
    }
  }

  .hero {
    padding: 92px 0 40px;
  }

  .hello {
    font-size: clamp(112px, 22vw, 212px);
    line-height: 0.82;
    letter-spacing: -0.035em;
    margin-left: -0.04em;
  }

  .hello [aria-hidden] > span {
    display: inline-block;
  }

  .hello .dot {
    color: var(--orange);
  }

  .lede {
    max-width: 30ch;
    margin-top: 40px;
    font-family: var(--serif);
    font-size: clamp(28px, 3vw, 36px);
    line-height: 1.12;
    letter-spacing: -0.005em;
    color: var(--ink);
    text-wrap: balance;
  }

  .lede strong {
    font-weight: 400;
    font-style: italic;
  }

  .circled {
    position: relative;
    white-space: nowrap;
  }

  .circled svg {
    position: absolute;
    inset: -14% -22% -18% -18%;
    width: 140%;
    height: 132%;
    overflow: visible;
    fill: none;
    stroke: var(--orange);
    stroke-width: 2.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }

  .circled path {
    vector-effect: non-scaling-stroke;
  }

  .role {
    display: flex;
    gap: 18px;
    margin-top: 36px;
    color: var(--ink-3);
  }

  .role span:first-child {
    color: var(--ink);
    font-weight: 600;
  }

  .role span + span::before {
    content: "/";
    margin-right: 18px;
    color: var(--orange-ink);
  }

  .block {
    padding: 72px 0 24px;
  }

  .today {
    font-size: 19px;
    line-height: 1.7;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .today em {
    font-family: var(--serif);
    font-size: 1.24em;
    line-height: 1;
    color: var(--ink);
  }

  .imo {
    color: var(--ink-3);
    font-family: var(--serif);
    font-style: italic;
    font-size: 15px;
    letter-spacing: 0;
    text-transform: none;
    margin-left: 6px;
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px dashed var(--rule);
  }

  .work {
    position: relative;
    border-top: 1px dashed var(--rule);
  }

  .work-link {
    display: grid;
    gap: 8px;
    padding: 30px 0 32px;
    text-decoration: none;
    color: inherit;
  }

  .work-link:focus-visible {
    outline-offset: 8px;
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-3);
  }

  .work-n {
    color: var(--orange-ink);
    font-weight: 600;
  }

  .chip {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--accent);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
  }

  .new {
    margin-left: 4px;
    padding: 3px 7px 2px;
    border: 1.5px solid var(--orange-ink);
    border-radius: 4px;
    color: var(--orange-ink);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    rotate: -5deg;
    box-shadow:
      inset 0 0 0 1.5px var(--sheet),
      inset 0 0 0 2.5px rgb(194 65 12 / 0.4);
  }

  .work-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    font-size: clamp(36px, 4vw, 48px);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .arrow {
    font-family: var(--sans);
    font-size: 22px;
    color: var(--ink-3);
    translate: -8px 0;
    opacity: 0;
    transition:
      translate 0.45s var(--ease-out),
      opacity 0.3s,
      color 0.3s;
  }

  .work-desc {
    color: var(--ink-2);
  }

  .work-tags {
    margin-top: 4px;
    font-size: 11px;
    color: var(--ink-3);
  }

  .work:hover .marker,
  .work-link:focus-visible .marker {
    background-size: 100% 100%;
  }

  .work:hover .arrow,
  .work-link:focus-visible .arrow {
    translate: 0 0;
    opacity: 1;
    color: var(--orange-ink);
  }

  .work :global(.work-scrap) {
    position: absolute;
  }

  .contact-lede {
    max-width: 46ch;
    color: var(--ink-2);
    font-size: 19px;
    line-height: 1.6;
  }

  .contact-list {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
  }

  .contact-list li {
    display: grid;
    grid-template-columns: 140px 1fr;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
    border-top: 1px dashed var(--rule);
  }

  .contact-list li:last-child {
    border-bottom: 1px dashed var(--rule);
  }

  .k {
    color: var(--ink-3);
  }

  .v {
    --accent: var(--orange);
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.1;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .v:hover .marker,
  .v:focus-visible .marker {
    background-size: 100% 100%;
  }

  .arr {
    font-family: var(--sans);
    font-size: 0.6em;
    color: var(--orange-ink);
  }

  .colophon {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px 24px;
    padding: 96px 0 40px;
    font-size: 11px;
    color: var(--ink-3);
  }

  .colophon a {
    color: var(--ink);
    text-decoration: none;
  }

  .colophon a:hover {
    color: var(--orange-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hello [aria-hidden] > span {
      animation: rise 1s var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 55ms + 80ms);
    }
    .lede,
    .role {
      animation: fade-up 0.9s var(--ease-out) 0.45s backwards;
    }
    .role {
      animation-delay: 0.6s;
    }
    .circled path {
      stroke-dasharray: 1;
      animation: draw 1.1s var(--ease-out) 1.1s backwards;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 0.4em;
      rotate: 8deg;
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @media (max-width: 1099px) {
    .desk {
      padding-top: 8px;
    }

    .hero-scraps {
      position: relative;
      max-width: 560px;
      height: clamp(230px, 46vw, 300px);
      margin: 0 auto -44px;
    }

    .hero-scraps :global(.hero-scrap) {
      left: auto !important;
      right: auto !important;
    }

    .hero-scraps :global(.hs-1) {
      left: 5% !important;
      top: 26px !important;
      width: 31%;
    }

    .hero-scraps :global(.hs-2) {
      left: 64% !important;
      top: 14px !important;
      width: 30%;
    }

    .hero-scraps :global(.hs-3) {
      left: 31% !important;
      top: 74px !important;
      width: 42%;
    }

    .hero-scraps :global(.hero-scrap.over) {
      z-index: auto;
    }

    .hero-scraps :global(.hero-scrap:is(.hs-4, .hs-5, .hs-6)) {
      display: none;
    }

    .note {
      display: none;
    }

    .work-link {
      padding-bottom: 18px;
    }

    .work :global(.work-scrap) {
      position: relative;
      display: inline-block;
      vertical-align: top;
      left: auto !important;
      right: auto !important;
      top: auto !important;
      margin: 8px 0 34px 4px;
    }

    .work :global(.work-scrap.main) {
      width: min(58%, 300px);
    }

    .work :global(.work-scrap.stamp-scrap) {
      width: min(52%, 220px);
    }

    .work :global(.work-scrap.second) {
      width: min(40%, 210px);
      margin: 40px 0 34px -6%;
    }
  }

  @media (max-width: 599px) {
    .hero {
      padding-top: 64px;
    }

    .lede {
      margin-top: 28px;
    }

    .role {
      flex-wrap: wrap;
      gap: 6px 14px;
    }

    .role span + span::before {
      margin-right: 14px;
    }

    .block {
      padding-top: 56px;
    }

    .today,
    .contact-lede {
      font-size: 17px;
    }

    .imo {
      display: none;
    }

    .contact-list li {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .colophon {
      grid-template-columns: 1fr;
      padding-top: 64px;
    }
  }
</style>
