---
import { getCollection } from "astro:content"
import Layout from "@/layouts/main.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import Arrow from "@/components/Arrow.astro"

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
)
const spans = ["s7", "s5", "s5", "s7", "s6", "s6"]
---

<Layout>
  <SiteHeader home />

  <main>
    <section class="hero wrap">
      <h1 class="name">
        <span class="reveal" style="--i:0">Elwann</span>
        <span class="reveal second" style="--i:1">Guillemot</span>
      </h1>
      <div class="meta reveal" style="--i:3">
        <p class="role">Back-end Developer</p>
        <p class="sub">Mostly Rust. Also the visuals around it.</p>
      </div>
      <a class="cue reveal" href="#today" style="--i:4">
        <span>Scroll</span>
        <Arrow angle={90} size={12} />
      </a>
    </section>

    <section id="today" class="wrap block">
      <p class="label"><span class="num">01</span>Today</p>
      <p class="statement">
        I spent my fourth year abroad at the <a
          class="soft-link"
          href="https://www.hanze.nl/en"
          target="_blank"
          rel="noopener noreferrer">Hanze University of Applied Sciences</a
        > in Groningen, Netherlands. Now I'm back at <a
          class="soft-link"
          href="https://www.aktislab.fr/"
          target="_blank"
          rel="noopener noreferrer">Aktislab</a
        > in Lyon, France, for my final year. Most of my time goes into building tools
        that make my life, and anyone else's, a little easier and more enjoyable.
        Things that feel fast and leave room for the <em>person using them</em>.
      </p>
    </section>

    <section id="work" class="wrap block" aria-labelledby="work-title">
      <p class="label"><span class="num">02</span>Selected work</p>
      <h2 id="work-title" class="statement">
        Some of my projects
        <span class="aside">(the most interesting ones imo!)</span>
      </h2>
      <div class="grid">
        {
          projects.map((p, i) => (
            <ProjectCard
              slug={p.id}
              title={p.data.title}
              description={p.data.description}
              tags={p.data.tags}
              cover={p.data.images[0]?.split("#")[0]}
              accent={p.data.accentColor}
              year={p.data.year}
              isNew={p.data.isNew}
              index={i}
              class={spans[i % spans.length]}
            />
          ))
        }
      </div>
    </section>

    <section id="contact" class="wrap block" aria-labelledby="contact-title">
      <p class="label"><span class="num">03</span>Contact</p>
      <div class="contact">
        <h2 id="contact-title" class="statement">
          Feel free to reach out if you're looking to collaborate on a project,
          have a job opportunity, or just want to connect.
        </h2>
        <ul role="list" class="reach">
          <li>
            <a class="row glass" href="mailto:elwann.guillemot@epitech.eu">
              <span class="k">Email me at</span>
              <span class="v">elwann.guillemot@epitech.eu</span>
              <Arrow size={18} />
            </a>
          </li>
          <li>
            <a
              class="row glass"
              href="https://github.com/elwqnn"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="k">On GitHub</span>
              <span class="v">@elwqnn</span>
              <Arrow angle={-45} size={18} />
            </a>
          </li>
          <li>
            <a class="row glass" href="/documents/elwann_guillemot_resume.pdf">
              <span class="k">Or check out my</span>
              <span class="v">Resume</span>
              <Arrow angle={90} size={18} />
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <p>© 2026 Elwann Guillemot</p>
    <a href="#" class="up">Back to top <Arrow angle={-90} size={12} /></a>
  </footer>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-content: end;
    column-gap: 1.25rem;
    min-height: calc(100svh - 6rem);
    padding-bottom: clamp(5rem, 12vh, 9rem);
  }

  .name {
    grid-column: 1 / -1;
    grid-row: 1;
    font-size: var(--fs-display);
    font-weight: 180;
    letter-spacing: -0.06em;
    line-height: 0.86;
  }

  .name span {
    display: block;
  }

  .second {
    padding-left: 0.62em;
  }

  .meta {
    grid-column: 9 / -1;
    grid-row: 1;
    align-self: start;
    padding-top: 0.6rem;
  }

  .role {
    font-size: var(--fs-lead);
    font-weight: 330;
    letter-spacing: -0.02em;
  }

  .sub {
    margin-top: 0.35rem;
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  .cue {
    grid-column: 9 / -1;
    grid-row: 2;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    font-size: var(--fs-micro);
    font-weight: 520;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .cue :global(.arrow) {
    animation: nudge 2.4s var(--ease-soft) infinite;
  }

  .block {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.25rem;
    row-gap: 2rem;
    padding-top: var(--section);
  }

  .block > .label {
    grid-column: 1 / 4;
    align-self: start;
    padding-top: 0.9em;
  }

  .statement {
    grid-column: 4 / -1;
    max-width: 30ch;
    font-size: var(--fs-statement);
    font-weight: 290;
    letter-spacing: -0.024em;
    line-height: 1.24;
    color: var(--ink);
    text-wrap: pretty;
  }

  #today .statement {
    max-width: 34ch;
    color: var(--ink-2);
  }

  #today .statement a,
  #today .statement em {
    color: var(--ink);
  }

  em {
    font-style: italic;
    font-weight: 330;
  }

  .aside {
    display: block;
    margin-top: 0.6rem;
    font-size: var(--fs-small);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-3);
  }

  .grid {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(0.75rem, 0.4rem + 1vw, 1.25rem);
    margin-top: clamp(1rem, 3vw, 3rem);
  }

  .grid > :global(.s7) {
    grid-column: span 7;
  }

  .grid > :global(.s5) {
    grid-column: span 5;
  }

  .grid > :global(.s6) {
    grid-column: span 6;
  }

  .contact {
    grid-column: 4 / -1;
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .reach {
    display: grid;
    gap: 0.6rem;
  }

  .row {
    display: grid;
    grid-template-columns: 10rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.6rem;
    border-radius: var(--radius-md);
    transition:
      transform 0.8s var(--ease-out),
      background-color 0.8s var(--ease-out);
  }

  .row:hover {
    transform: translateX(6px);
    background-color: rgb(255 255 255 / 0.3);
  }

  .row :global(.arrow) {
    transition: translate 0.8s var(--ease-out);
  }

  .row:hover :global(.arrow) {
    translate: 4px 0;
  }

  .k {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .v {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: clamp(1.15rem, 0.9rem + 1vw, 1.75rem);
    font-weight: 320;
    letter-spacing: -0.02em;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: var(--section);
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .up {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-2);
  }

  @keyframes nudge {
    50% {
      translate: 0 3px;
    }
  }

  @media (max-width: 60rem) {
    .grid > :global(.s7),
    .grid > :global(.s5),
    .grid > :global(.s6) {
      grid-column: span 6;
    }

    .block > .label {
      grid-column: 1 / -1;
      padding-top: 0;
    }

    .statement,
    .contact {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      min-height: calc(100svh - 5rem);
      padding-bottom: 6rem;
    }

    .second {
      padding-left: 0.3em;
    }

    .meta,
    .cue {
      grid-column: 1 / -1;
    }

    .meta {
      grid-row: 2;
      padding-top: 2rem;
    }

    .cue {
      grid-row: 3;
    }

    .grid > :global(.s7),
    .grid > :global(.s5),
    .grid > :global(.s6) {
      grid-column: 1 / -1;
    }

    .row {
      grid-template-columns: 1fr auto;
      padding: 1rem 1.15rem;
      row-gap: 0.15rem;
    }

    .row .k {
      grid-column: 1 / -1;
    }
  }
</style>
