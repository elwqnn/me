---
import { getCollection } from "astro:content"
import Layout from "@/layouts/main.astro"
import Bitmap from "@/components/Bitmap.astro"
import Field from "@/components/Field.astro"
import Arrow from "@/components/Arrow.astro"

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
)

const spans = [
  "lg:col-span-7",
  "lg:col-span-5",
  "lg:col-span-7",
  "lg:col-span-5",
  "lg:col-span-5",
  "lg:col-span-7",
]
const pad = (n: number) => String(n).padStart(2, "0")

const contacts = [
  {
    label: "GitHub",
    value: "@elwqnn",
    href: "https://github.com/elwqnn",
    external: true,
  },
  {
    label: "Email",
    value: "elwann.guillemot@epitech.eu",
    href: "mailto:elwann.guillemot@epitech.eu",
    external: false,
  },
  {
    label: "Resume",
    value: "elwann_guillemot_resume.pdf",
    href: "/documents/elwann_guillemot_resume.pdf",
    external: false,
  },
]
---

<Layout>
  <header id="top" class="row label grid-cols-2 md:grid-cols-12">
    <a
      href="/"
      class="cell cell-link invert-hover flex items-center gap-3 md:col-span-2"
      aria-label="Elwann Guillemot, home"
    >
      <span class="dot text-[20px] leading-none">EG</span>
      <span class="hidden md:inline">Index</span>
    </a>
    <p class="cell md:col-span-3">Elwann Guillemot</p>
    <p class="cell hidden md:col-span-3 md:block">Back-end Developer</p>
    <a
      href="#work"
      class="cell cell-link invert-hover flex justify-between md:col-span-2"
    >
      <span>Work</span><span>(01)</span>
    </a>
    <a
      href="#contact"
      class="cell cell-link invert-hover flex justify-between md:col-span-2"
    >
      <span>Contact</span><span>(02)</span>
    </a>
  </header>

  <main class="stack">
    <section class="row hero grid-cols-1" aria-label="Introduction">
      <h1 class="name boot cell dot">
        <span class="block md:inline">Elwann</span>
        <span class="block md:inline">Guillemot</span>
      </h1>
    </section>

    <section class="row grid-cols-1 lg:grid-cols-12">
      <div
        class="cell relative aspect-[4/3] p-0 sm:aspect-[16/9] lg:col-span-7 lg:aspect-auto lg:min-h-[400px]"
      >
        <Field class="absolute inset-0" />
        <p
          class="label pointer-events-none absolute top-0 left-0 border-r border-b border-ink bg-paper px-3 py-2"
        >
          Fig. 00 &mdash; Noise, 1-bit
        </p>
        <p
          class="label pointer-events-none absolute right-0 bottom-0 border-t border-l border-ink bg-paper px-3 py-2"
        >
          <span class="hidden [@media(hover:hover)]:inline"
            >Move to light it</span
          >
          <span class="[@media(hover:hover)]:hidden">Touch to light it</span>
        </p>
      </div>
      <div class="stack lg:col-span-5">
        <div class="cell">
          <p class="label mb-3">Role</p>
          <p class="dot text-[clamp(30px,3.3vw,52px)]">Back-end Developer</p>
        </div>
        <div class="cell flex-1">
          <h2 class="label mb-3">Today</h2>
          <p class="max-w-[52ch] text-[16px] leading-[1.65]">
            I spent my fourth year abroad at the <a
              href="https://www.hanze.nl/en"
              class="ulink"
              target="_blank"
              rel="noopener noreferrer">Hanze University of Applied Sciences</a
            > in Groningen, Netherlands. Now I'm back at <a
              href="https://www.aktislab.fr/"
              class="ulink"
              target="_blank"
              rel="noopener noreferrer">Aktislab</a
            > in Lyon, France, for my final year. Most of my time goes into building
            tools that make my life, and anyone else's, a little easier and more enjoyable.
            Things that feel fast and leave room for the <mark
              class="bg-ink px-1 text-paper">person using them</mark
            >.
          </p>
        </div>
      </div>
    </section>

    <section
      id="work"
      class="row scroll-mt-4 grid-cols-1 lg:grid-cols-12"
      aria-labelledby="work-title"
    >
      <div
        class="cell flex flex-wrap items-end justify-between gap-x-8 gap-y-2 lg:col-span-12"
      >
        <h2 id="work-title" class="dot text-[clamp(44px,6vw,96px)]">Work</h2>
        <p class="label pb-1">
          {pad(projects.length)} projects, the most interesting ones
        </p>
      </div>
      {
        projects.map((project, i) => (
          <a
            href={`/projects/${project.id}`}
            class:list={[
              "card cell cell-link group flex flex-col p-0",
              spans[i % spans.length],
            ]}
          >
            <Bitmap
              src={project.data.images[0]}
              alt={`${project.data.title} cover`}
              accent={project.data.accentColor}
              eager={i < 2}
              class="aspect-[4/3] border-b border-ink sm:aspect-[16/10] lg:aspect-auto lg:h-[clamp(300px,33vw,560px)]"
            />
            <div class="flex flex-1 flex-col gap-3 p-[var(--pad)]">
              <div class="label flex items-center justify-between gap-4">
                <span>{pad(i + 1)}</span>
                <span class="flex items-center gap-3">
                  {project.data.isNew && <span class="tag-new">New</span>}
                  {project.data.year}
                  <Arrow
                    dir="out"
                    size={10}
                    class="transition-transform duration-300 ease-[var(--ease)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </span>
              </div>
              <h3 class="title dot text-[clamp(32px,3.4vw,54px)]">
                {project.data.title}
              </h3>
              <p class="max-w-[48ch]">{project.data.description}</p>
              <p class="label mt-auto pt-2">{project.data.tags.join(" / ")}</p>
            </div>
          </a>
        ))
      }
    </section>

    <section
      id="contact"
      class="row scroll-mt-4 grid-cols-1 lg:grid-cols-12"
      aria-labelledby="contact-title"
    >
      <div class="cell flex flex-col justify-between gap-8 lg:col-span-5">
        <h2 id="contact-title" class="dot text-[clamp(44px,6vw,96px)]">
          Contact
        </h2>
        <p class="max-w-[40ch] text-[16px] leading-[1.65]">
          Feel free to reach out if you're looking to collaborate on a project,
          have a job opportunity, or just want to connect.
        </p>
      </div>
      <ul class="stack lg:col-span-7">
        {
          contacts.map((c, i) => (
            <li class="cell flex-1 p-0">
              <a
                href={c.href}
                class="cell-link invert-hover grid h-full grid-cols-[auto_1fr_auto] items-center gap-x-5 gap-y-1 p-[var(--pad)] sm:grid-cols-[2.5rem_9rem_1fr_auto] lg:py-7"
                {...(c.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                <span class="label">{pad(i + 1)}</span>
                <span class="dot text-[clamp(26px,2.6vw,40px)]">{c.label}</span>
                <span class="col-span-3 row-start-2 truncate sm:col-span-1 sm:row-start-auto">
                  {c.value}
                </span>
                <Arrow
                  dir={c.label === "Resume" ? "down" : "out"}
                  size={14}
                  class="col-start-3 row-start-1 sm:col-start-auto sm:row-start-auto"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>

<style>
  .hero {
    container-type: inline-size;
  }

  .name {
    font-size: calc((100cqi - 2 * var(--pad)) / 5.42);
    padding-block: clamp(20px, 3vw, 44px) clamp(16px, 2.4vw, 36px);
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .name {
      font-size: calc((100cqi - 2 * var(--pad)) / 9.52);
    }
  }
</style>
