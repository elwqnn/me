---
import { getCollection, render } from "astro:content"
import Layout from "@/layouts/main.astro"
import Top from "@/components/Top.astro"
import Wght from "@/components/Wght.astro"
import Plate from "@/components/Plate.astro"
import Arrow from "@/components/Arrow.astro"
import { pad, shot } from "@/components/image"

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order
  )
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      index,
      total: projects.length,
      next: projects[(index + 1) % projects.length],
      nextIndex: ((index + 1) % projects.length) + 1,
    },
  }))
}

const { project, index, total, next, nextIndex } = Astro.props
const { Content } = await render(project)
const {
  title,
  description,
  tags,
  images,
  links,
  githubUrl,
  liveUrl,
  year,
  isNew,
  accentColor,
} = project.data

const shots = images.map(shot)
const visuals = shots.length > 0 ? shots : [null]
const accent = accentColor ?? "#d5d2ca"
const allLinks = [
  ...links,
  ...(liveUrl ? [{ label: "Live preview", url: liveUrl }] : []),
  ...(githubUrl ? [{ label: "Source code", url: githubUrl }] : []),
]
---

<Layout
  title={`${title} — Elwann Guillemot`}
  description={description}
  image={shots[0]?.src}
>
  <Top current="projects" />
  <main class="project" style={`--accent:${accent}`}>
    <header class="head">
      <p class="kicker meta">
        <span class="dot" aria-hidden="true"></span>
        <span class="label">{pad(index + 1)}/{pad(total)}</span>
        <span>{year}</span>
        {isNew && <span class="new">New</span>}
      </p>
      <Wght as="h1" text={title} class="title" intro />
      <p class="lede">{description}</p>
    </header>

    <div class="body">
      <aside class="side meta" aria-label="Project details">
        <dl>
          <div>
            <dt class="mute">Project</dt>
            <dd>{title}</dd>
          </div>
          <div>
            <dt class="mute">Year</dt>
            <dd>{year}</dd>
          </div>
          <div>
            <dt class="mute">Stack</dt>
            <dd>
              <ul class="tags">{tags.map((tag) => <li>{tag}</li>)}</ul>
            </dd>
          </div>
          <div>
            <dt class="mute">Links</dt>
            <dd>
              <ul>
                {
                  allLinks.map((link) => (
                    <li>
                      <a
                        class="u"
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {link.label}
                      </a>{" "}
                      <Arrow />
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
          {
            shots.length > 0 && (
              <div>
                <dt class="mute">Image</dt>
                <dd>
                  <span data-at>01</span>/{pad(shots.length)}
                </dd>
              </div>
            )
          }
        </dl>
      </aside>

      <div class="main">
        {
          visuals.map((s, i) => (
            <>
              {s ? (
                <figure class="shot" data-n={i}>
                  <a
                    href={s.src}
                    data-shot
                    aria-label={`Open ${title}: ${s.name} at full size`}
                  >
                    <img
                      src={s.src}
                      alt={`${title}: ${s.name}`}
                      width={s.width}
                      height={s.height}
                      style={`--ar:${s.width}/${s.height}`}
                      class:list={{ pixel: s.width < 1000 }}
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </a>
                  <figcaption class="meta mute">
                    <span>
                      {pad(i + 1)}/{pad(shots.length)}
                    </span>
                    <span>{s.name}</span>
                  </figcaption>
                </figure>
              ) : (
                <Plate
                  title={title}
                  top={tags.join(" · ")}
                  bottom={year}
                  color={accent}
                  class="plate"
                />
              )}
              {i === 0 && (
                <div class="prose">
                  <Content />
                </div>
              )}
            </>
          ))
        }
      </div>
    </div>

    <nav class="next" aria-label="Next project">
      <a href={`/projects/${next.id}`}>
        <span class="meta mute">
          <span class="label">Next</span>
          {pad(nextIndex)}/{pad(total)}
        </span>
        <span class="next-row">
          <Wght text={next.data.title} class="next-title" />
          <Arrow dir="e" class="go" />
        </span>
      </a>
    </nav>
  </main>

  {
    shots.length > 0 && (
      <dialog class="lb" data-lb aria-label={`${title} images`}>
        <div class="lb-bar meta">
          <span data-lb-at />
          {shots.length > 1 && (
            <span class="lb-nav">
              <button type="button" data-lb-step="-1">
                Prev
              </button>
              <button type="button" data-lb-step="1">
                Next
              </button>
            </span>
          )}
          <button type="button" data-lb-close autofocus>
            Close
          </button>
        </div>
        <img data-lb-img alt="" />
      </dialog>
    )
  }
</Layout>

<style>
  .project {
    padding: 0 var(--gutter);
  }

  .head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    padding-top: clamp(48px, 9vw, 150px);
  }

  .kicker {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 1em;
    margin-bottom: 1.2em;
  }

  .dot {
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .new {
    padding: 0.15em 0.65em 0.2em;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
  }

  .head :global(.title) {
    grid-column: 1 / -1;
    font-size: clamp(60px, 15vw, 300px);
    line-height: 0.84;
    letter-spacing: -0.045em;
    margin-left: -0.04em;
    text-wrap: balance;
  }

  .lede {
    grid-column: 4 / span 7;
    margin-top: clamp(28px, 4vw, 64px);
    font-size: clamp(22px, 0.8rem + 1.6vw, 40px);
    line-height: 1.12;
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  .body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    margin-top: clamp(56px, 8vw, 128px);
  }

  .side {
    grid-column: 1 / span 3;
    align-self: end;
    position: sticky;
    bottom: var(--gutter);
  }

  dl {
    display: grid;
    gap: 0.5em;
    max-width: 22em;
  }

  dl > div {
    display: grid;
    grid-template-columns: 5em 1fr;
    gap: 1em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tags li:not(:last-child)::after {
    content: ",\00a0";
  }

  dd :global(.arrow) {
    width: 0.8em;
    height: 0.8em;
  }

  .main {
    grid-column: 4 / -1;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2vw, 32px);
  }

  .shot a {
    display: block;
    cursor: zoom-in;
  }

  .shot a:focus-visible {
    outline: none;
  }

  .shot a:focus-visible img {
    outline: 1.5px solid var(--ink);
    outline-offset: 4px;
  }

  .shot img {
    width: min(100%, 92svh * var(--ar));
    background: var(--paper-2);
    box-shadow: 0 0 0 1px var(--line);
  }

  .pixel {
    image-rendering: pixelated;
  }

  figcaption {
    display: flex;
    gap: 1.2em;
    padding-top: 0.7em;
  }

  .main :global(.plate) {
    aspect-ratio: 16 / 9;
    height: auto;
  }

  .main :global(.plate .plate-title) {
    font-size: 22cqw;
  }

  .prose {
    max-width: 34em;
    padding: clamp(40px, 6vw, 104px) 0;
    font-size: clamp(17px, 0.9rem + 0.35vw, 21px);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .prose :global(p + p) {
    margin-top: 1em;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    transition: text-decoration-color 0.3s var(--out);
  }

  .prose :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .next {
    margin-top: clamp(96px, 14vw, 220px);
    border-top: 1px solid var(--line);
  }

  .next a {
    display: block;
    padding-top: 0.9em;
  }

  .next-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.2em;
    margin-top: 0.3em;
    font-size: clamp(48px, 9vw, 168px);
    line-height: 0.86;
    letter-spacing: -0.045em;
  }

  .next-row :global(.next-title) {
    margin-left: -0.04em;
  }

  .next-row :global(.go) {
    width: 0.6em;
    height: 0.6em;
    margin-bottom: 0.08em;
  }

  @media (hover: hover) {
    .next a:hover :global(.go) {
      translate: 0.12em 0;
    }
  }

  .lb {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--gutter);
    border: 0;
    background: var(--paper);
    color: var(--ink);
  }

  .lb[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--gutter);
  }

  .lb::backdrop {
    background: transparent;
  }

  .lb-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .lb-nav {
    display: flex;
    gap: 1.5em;
  }

  .lb-bar button {
    padding: 0.3em 0;
  }

  .lb img {
    place-self: center;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    cursor: zoom-out;
  }

  :global(html:has(dialog[open])) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lb[open] {
      animation: lb-in 0.45s var(--out);
    }

    .lb[open] img {
      animation: lb-img 0.7s var(--out);
    }
  }

  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }

  @keyframes lb-img {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  @media (max-width: 760px) {
    .lede {
      grid-column: 1 / -1;
    }

    .body {
      display: flex;
      flex-direction: column;
      gap: 40px;
    }

    .side {
      position: static;
      align-self: stretch;
    }

    .shot img {
      width: 100%;
    }
  }
</style>

<script>
  const pad = (n: number) => String(n).padStart(2, "0")

  const at = document.querySelector<HTMLElement>("[data-at]")
  const figures = document.querySelectorAll<HTMLElement>(".shot")
  if (at && figures.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            at.textContent = pad(
              Number(entry.target.getAttribute("data-n")) + 1
            )
          }
        }
      },
      { rootMargin: "-50% 0px -50% 0px" }
    )
    figures.forEach((f) => io.observe(f))
  }

  const dialog = document.querySelector<HTMLDialogElement>("[data-lb]")
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-shot]")]
  if (dialog && links.length) {
    const img = dialog.querySelector<HTMLImageElement>("[data-lb-img]")!
    const count = dialog.querySelector<HTMLElement>("[data-lb-at]")!
    let current = 0

    const show = (n: number) => {
      current = (n + links.length) % links.length
      const link = links[current]
      img.src = link.getAttribute("href")!
      img.alt = link.querySelector("img")?.alt ?? ""
      count.textContent = `${pad(current + 1)}/${pad(links.length)}`
    }

    links.forEach((link, n) =>
      link.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
        e.preventDefault()
        show(n)
        dialog.showModal()
      })
    )

    dialog.addEventListener("click", (e) => {
      const target = e.target as HTMLElement
      const step = target.closest<HTMLElement>("[data-lb-step]")
      if (step) show(current + Number(step.dataset.lbStep))
      else if (!target.closest(".lb-bar") || target.closest("[data-lb-close]"))
        dialog.close()
    })

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") show(current + 1)
      if (e.key === "ArrowLeft") show(current - 1)
    })
  }
</script>
